<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsKhanza.UI.App"
             RequestedThemeVariant="Light">
             <!-- Light by default (matches the legacy app's white-background look);
                  toggled to Dark at runtime from MainWindow's theme switch. -->

    <Application.Resources>
        <!-- Gramedika palette sampled from the supplied logo: brand blue #031C6D,
             logo red #E50108, with restrained blue tints and neutral surfaces. -->
        <ResourceDictionary>
            <Thickness x:Key="MenuFlyoutPresenterThemePadding">3</Thickness>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://SimrsKhanza.UI/Styles/AppMark.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TegasPageBrush">#EAF1FC</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasHeadingBrush">#DEE9FA</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasHeadingEdgeBrush">#031C6D</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasRowAltBrush">#F2F6FC</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasNavigationBrush">#031C6D</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasTableHeaderBrush">#113578</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasActionBrush">#244B91</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryBrush">#031C6D</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryDarkBrush">#02144E</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryLightBrush">#3868C0</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeAccentBrush">#E50108</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#F6F8FC</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush">#EEF2F8</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePanelBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTableHeaderBrush">#E8EEF7</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeIconBrush">#123F8D</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeIconBackgroundBrush">#E8F0FC</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#D9E1EE</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextBrush">#1B2638</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush">#5D697B</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeOnPrimaryBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeRowAltBrush">#F6F8FB</SolidColorBrush>
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="ThemePanelBrush" />
                    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="ThemeBorderBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronSubMenuOpened" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="ThemeOnPrimaryBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="ThemeTextSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TegasPageBrush">#000000</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasHeadingBrush">#191919</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasHeadingEdgeBrush">#8CB0FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasRowAltBrush">#101010</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasNavigationBrush">#000000</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasTableHeaderBrush">#222222</SolidColorBrush>
                    <SolidColorBrush x:Key="TegasActionBrush">#3565A7</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryBrush">#3157A1</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryDarkBrush">#000000</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryLightBrush">#8FB4FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeAccentBrush">#FF7378</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#000000</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush">#181818</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePanelBrush">#0D0D0D</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTableHeaderBrush">#222222</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeIconBrush">#ABC5FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeIconBackgroundBrush">#242424</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#454545</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextBrush">#F2F2F2</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush">#BDBDBD</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeOnPrimaryBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeRowAltBrush">#101010</SolidColorBrush>
                    <StaticResource x:Key="MenuFlyoutPresenterBackground" ResourceKey="ThemePanelBrush" />
                    <StaticResource x:Key="MenuFlyoutPresenterBorderBrush" ResourceKey="ThemeBorderBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevron" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronPointerOver" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronSubMenuOpened" ResourceKey="ThemeIconBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronPressed" ResourceKey="ThemeOnPrimaryBrush" />
                    <StaticResource x:Key="MenuFlyoutSubItemChevronDisabled" ResourceKey="ThemeTextSecondaryBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!--
            DataGrid has its own control template that FluentTheme does NOT pull
            in automatically (Registrasi/RawatInap/etc. all use DataGrid). Without
            this, DataGrid renders with no template at all — headers, rows, grid
            lines, everything invisible — even though data is bound correctly
            (which is exactly what caused the "Record : 2 but blank area below"
            report). An earlier session removed this include on the assumption
            FluentTheme already covered it; that assumption was wrong.
        -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- App-wide subtle zebra striping — Avalonia's DataGrid has no
             AlternatingRowBackground property (unlike WPF's), so this uses
             the :nth-child(2n) structural pseudo-class on DataGridRow
             instead. Applies to every DataGrid (Registrasi, IGD, Lab,
             Farmasi, …) without having to set it per-screen. -->
        <Style Selector="DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}" />
        </Style>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable, Arial" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBox, ComboBox, DatePicker, CalendarDatePicker, Button, ToggleButton, CheckBox, RadioButton, TabItem, MenuItem">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="DayFormat" Value="d" />
            <Setter Property="MonthFormat" Value="MMMM" />
            <Setter Property="YearFormat" Value="yyyy" />
            <Setter Property="DayVisible" Value="True" />
            <Setter Property="MonthVisible" Value="True" />
            <Setter Property="YearVisible" Value="True" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="CalendarDatePicker">
            <Setter Property="FirstDayOfWeek" Value="Sunday" />
            <Setter Property="IsTodayHighlighted" Value="True" />
            <Setter Property="SelectedDateFormat" Value="Custom" />
            <Setter Property="CustomDateFormatString" Value="dd/MM/yyyy" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="CalendarDatePicker /template/ Button#PART_Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="Calendar">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="CalendarDayButton">
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="CalendarDayButton:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="CalendarDayButton /template/ Border#Root, CalendarDayButton /template/ Border#Border">
            <Setter Property="CornerRadius" Value="7" />
        </Style>
        <Style Selector="CalendarDayButton:today /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="CalendarDayButton:today /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="CalendarDayButton:today /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="CalendarDayButton:selected /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <Style Selector="CalendarDayButton:selected /template/ Border#Border">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <Style Selector="CalendarDayButton:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="CalendarButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="CalendarButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="ContextMenu, MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinWidth" Value="184" />
            <Setter Property="MaxHeight" Value="520" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <!-- Fluent applies interaction colors to the template parts, including for keyboard selection. -->
        <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:open /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
        <Style Selector="MenuItem:pressed /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <Style Selector="MenuItem:pressed /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
        </Style>
        <Style Selector="MenuItem:disabled /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        </Style>
        <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="ContextMenu Separator, MenuFlyoutPresenter Separator, MenuItem Separator">
            <Setter Property="Margin" Value="7,2" />
        </Style>
        <!-- Keep Fluent's scroll interaction but show a stable, visible track and thumb. -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="22" />
            <Setter Property="MinWidth" Value="22" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ThemeTextSecondaryBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
            <Setter Property="Fill" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="ScrollBar:horizontal /template/ Thumb"><Setter Property="MinHeight" Value="16" /><Setter Property="MinWidth" Value="48" /></Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb">
            <Setter Property="Width" Value="16" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryLightBrush}" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryLightBrush}" />
        </Style>
        <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover /template/ Border, ScrollBar:vertical /template/ Thumb:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
        <Style Selector="ComboBox#MenuCategoryCombo">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
        <Style Selector="ComboBox#MenuCategoryCombo /template/ Border#PopupBorder">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter, ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
        </Style>
        <Style Selector="DataGridColumnHeader /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource ThemeTableHeaderBrush}" />
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="FontSize" Value="{ReflectionBinding $parent[DataGrid].FontSize}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ContentControl.biruTegas TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Border.servicePanel">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="Border.tegasHeading">
            <Setter Property="Background" Value="{DynamicResource TegasHeadingBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TegasHeadingEdgeBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,5,9,5" />
        </Style>
        <Style Selector="ContentControl.biruTegas TextBlock.pageSubtitle">
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGrid">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="RowHeight" Value="26" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGridCell TextBlock">
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource TegasRowAltBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button, ContentControl.biruTegas ToggleButton, ContentControl.biruTegas TextBox, ContentControl.biruTegas ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="7,3" />
        </Style>
        <Style Selector="Border#InputDataPanel TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border#InputDataPanel TextBox:readonly">
            <Setter Property="Background" Value="{DynamicResource TegasHeadingBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="{DynamicResource TegasTableHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
            <Setter Property="SeparatorBrush" Value="{DynamicResource TegasTableHeaderBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGridColumnHeader /template/ Grid#PART_ColumnHeaderRoot">
            <Setter Property="Background" Value="{DynamicResource TegasTableHeaderBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas DataGridColumnHeader /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button.accent">
            <Setter Property="Background" Value="{DynamicResource TegasActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button">
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TegasActionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas Button.accent:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        </Style>
        <Style Selector="ContentControl.biruTegas TextBox, ContentControl.biruTegas ComboBox">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="ToggleButton.inputData">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ToggleButton.inputData:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
        <Style Selector="ToggleButton.inputData:checked Path">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="Button.clinicalTile">
            <Setter Property="Height" Value="110" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.clinicalTile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
        <Style Selector="TextBlock.registrationStatus">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.registrationStatus.saved">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
        <Style Selector="TextBlock.registrationStatus.error">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
