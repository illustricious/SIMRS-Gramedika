<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsKhanza.UI.App"
             RequestedThemeVariant="Light">
             <!-- Light by default (matches the legacy app's white-background look);
                  toggled to Dark at runtime from MainWindow's theme switch. -->

    <Application.Resources>
        <!--
            Color palette sampled from https://www.rsugramedika10.com/ (the user's
            reference for "how it should look"): deep blue primary (#1E3A8A),
            red accent (#DC2626), white background, slate neutrals. Dark variant
            uses the same blue/red accents on a comfortable (not black) gray.
            See docs/audit/PLANNING_APLIKASI.md for why the shell mirrors the
            legacy frmUtama layout (two-row shortcut toolbar + status bar).
        -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ThemePrimaryBrush">#1E3A8A</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryDarkBrush">#172B66</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryLightBrush">#3B82F6</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeAccentBrush">#DC2626</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#E2E8F0</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextBrush">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush">#64748B</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeOnPrimaryBrush">#FFFFFF</SolidColorBrush>
                    <!-- Subtle zebra striping for DataGrid rows (odd = white/background, even = this) -->
                    <SolidColorBrush x:Key="ThemeRowAltBrush">#EFF5FC</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ThemePrimaryBrush">#2E4F9E</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryDarkBrush">#223B78</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemePrimaryLightBrush">#60A5FA</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeAccentBrush">#F87171</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBackgroundBrush">#2A2E35</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeSurfaceBrush">#363B44</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeBorderBrush">#454B56</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextBrush">#E2E8F0</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeTextSecondaryBrush">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeOnPrimaryBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ThemeRowAltBrush">#30384A</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!--
            DataGrid has its own control template that FluentTheme does NOT pull
            in automatically (Registrasi/RawatInap/etc. all use DataGrid). Without
            this, DataGrid renders with no template at all — headers, rows, grid
            lines, everything invisible — even though data is bound correctly
            (which is exactly what caused the "Record : 2 but blank area below"
            report). An earlier session removed this include on the assumption
            FluentTheme already covered it; that assumption was wrong.
        -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- App-wide subtle zebra striping — Avalonia's DataGrid has no
             AlternatingRowBackground property (unlike WPF's), so this uses
             the :nth-child(2n) structural pseudo-class on DataGridRow
             instead. Applies to every DataGrid (Registrasi, IGD, Lab,
             Farmasi, …) without having to set it per-screen. -->
        <Style Selector="DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource ThemeRowAltBrush}" />
        </Style>
    </Application.Styles>
</Application>