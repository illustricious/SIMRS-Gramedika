<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows executable icon generated at multiple sizes from Assets/app.svg. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Product identity shown in Windows file properties / installers. AssemblyName stays
         SimrsKhanza.UI because every avares://SimrsKhanza.UI/... asset URI depends on it. -->
    <Product>SIMRS Gramedika</Product>
    <AssemblyTitle>SIMRS Gramedika</AssemblyTitle>
    <Description>Sistem Informasi Manajemen Rumah Sakit — SIMRS Gramedika</Description>
    <Company>RSU Gramedika</Company>
    <Copyright>RSU Gramedika</Copyright>
    <Version>0.2.0-alpha</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimrsKhanza.Core\SimrsKhanza.Core.csproj" />
    <ProjectReference Include="..\SimrsKhanza.Data\SimrsKhanza.Data.csproj" />
    <ProjectReference Include="..\SimrsKhanza.Config\SimrsKhanza.Config.csproj" />
  </ItemGroup>
</Project>
