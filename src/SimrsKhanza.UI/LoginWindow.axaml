<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimrsKhanza.UI.LoginWindow"
        Title="Login — SIMRS Khanza"
        Width="380" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#2E4057">

    <!--
        Legacy reference: login is embedded inside src/simrskhanza/frmUtama.java
        (fields edAdmin/edPwd + DlgLogin overlay). Here it is split out into its
        own window calling Core.Auth.IAuthService, per PLANNING_APLIKASI.md §2.
    -->
    <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="SIMRS KHANZA" FontSize="22" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12" />

        <TextBlock Text="User ID" Foreground="#C7D0DB" />
        <TextBox Name="UserIdBox" Text="admin" PlaceholderText="user id" />

        <TextBlock Text="Password" Foreground="#C7D0DB" />
        <TextBox Name="PasswordBox" PasswordChar="*" PlaceholderText="password" Text="admin123" />

        <TextBlock Name="ErrorText" Foreground="#E07A5F" IsVisible="False" TextWrapping="Wrap" />

        <Button Name="LoginButton" Content="Masuk" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Margin="0,8,0,0" Click="OnLoginClick" />

        <TextBlock Text="Dev seed: admin / admin123 (belum terhubung ke DB sik asli)"
                   FontSize="10" Foreground="#8EA3B0" HorizontalAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
</Window>
