<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="SimrsKhanza.UI.MainWindow"
        Title="SIMRS Gramedika"
        Icon="avares://SimrsKhanza.UI/Assets/logo.png"
        Width="1200" Height="760"
        WindowState="Maximized"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ThemePrimaryBrush}">

    <!--
        Shell layout mirrors the legacy src/simrskhanza/frmUtama.java screen:
        a two-row shortcut toolbar (top row = secondary/admin menus, second row
        = direct-access feature shortcuts incl. "Menu"), a content area that
        shows a hero/welcome panel until "Menu" is clicked (then an icon-grid
        dashboard, data-driven from IMenuPermissionService), and a status bar.
        Color palette sampled from rsugramedika10.com (the user's reference):
        deep blue primary, red accent, white/gray via App.axaml ThemeDictionaries.
        See docs/audit/PLANNING_APLIKASI.md for the full rationale.

        NOTE: an earlier revision wrapped this whole shell in a
        LayoutTransformControl at 85% scale to shrink everything app-wide —
        REVERTED per user feedback ("jangan jadi kecil banget semua
        tampilannya"), they only meant the Registrasi grid's font felt too
        large, not a global zoom-out. Font-size tuning now stays scoped to the
        specific screen that needs it (see RegistrasiView.axaml) instead of a
        blanket transform on the whole app.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: top shortcut bar — secondary/admin menus. Doubles as the window
             title bar (client area is extended, system chrome is off): the empty
             space is the drag handle and the minimize/maximize/close buttons sit
             on the same blue strip, per user request. -->
        <Border Grid.Row="0" Name="TitleBar" Background="{DynamicResource ThemePrimaryBrush}"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="avares://SimrsKhanza.UI/Assets/logo.png" Width="20" Height="20" Margin="10,0,4,0"
                           VerticalAlignment="Center" />
                    <Button Classes="shortcut" Content="Program" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Presensi Pegawai" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Informasi" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Anjungan &amp; Antrian" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Tentang Program" Click="OnTopShortcutClick" />
                    <Border Width="1" Background="#2A4FA8" Margin="4,8" />
                    <ToggleButton Name="ThemeToggle" Classes="shortcut" Content="🌙 Mode Gelap"
                                  Click="OnThemeToggleClick" HorizontalAlignment="Right" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SIMRS Gramedika" Foreground="#B9C6E8" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Classes="caption" Content="—" Click="OnMinimizeClick" />
                    <Button Classes="caption" Name="MaximizeButton" Content="❐" Click="OnMaximizeClick" />
                    <Button Classes="caption close" Content="✕" Click="OnExitClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1: feature shortcuts (direct access, mirrors legacy second toolbar row) -->
        <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Name="MenuShortcut" Classes="shortcut2" Content="☰  Menu" Click="OnMenuShortcutClick" />
                <Button Classes="shortcut2" Content="Registrasi" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="IGD/UGD" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="Laboratorium" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="Radiologi" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="Farmasi" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="Rawat Inap" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2" Content="Rawat Jalan" Click="OnFeatureShortcutClick" />
                <Button Classes="shortcut2 accent" Content="Keluar" Click="OnExitClick" HorizontalAlignment="Right" />
            </StackPanel>
        </Border>

        <!-- Row 2: content area — hero panel by default, dashboard grid after "Menu" -->
        <Grid Grid.Row="2" Name="ContentHost" Background="{DynamicResource ThemeBackgroundBrush}">

            <!-- Hero / welcome panel (default view, mirrors the legacy splash-like home screen) -->
            <StackPanel Name="HeroPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <Image Source="avares://SimrsKhanza.UI/Assets/logo.png" Width="96" Height="96"
                       Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="SIMRS GRAMEDIKA" FontSize="40" FontWeight="Bold"
                           Foreground="{DynamicResource ThemePrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Rewrite scaffold — C# + Avalonia UI" FontSize="14"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Klik &quot;Menu&quot; di toolbar untuk membuka daftar modul." FontSize="13"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,24,0,0" />
            </StackPanel>

            <!-- Menu / dashboard panel (shown after clicking "Menu") -->
            <Grid Name="MenuPanel" IsVisible="False" RowDefinitions="Auto,*" Margin="16">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0" Text="Tampilkan Menu:" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextBrush}" Margin="0,0,8,0" />
                    <ComboBox Grid.Column="1" Name="MenuCategoryCombo" HorizontalAlignment="Left" MinWidth="520" MaxDropDownHeight="520" />
                </Grid>
                <ScrollViewer Grid.Row="1" Name="DashboardScroll">
                    <UniformGrid Name="DashboardPanel" Columns="5" />
                </ScrollViewer>
            </Grid>

            <!-- Feature page host — single-window navigation: clicking a feature
                 shortcut (e.g. "Registrasi") swaps content in here instead of
                 opening a new Window, per the user's feedback. -->
            <ContentControl Name="PageHost" IsVisible="False" />
        </Grid>

        <!-- Row 3: status bar, mirrors legacy "Status Admin / date / IP / credit" footer -->
        <Border Grid.Row="3" Background="{DynamicResource ThemePrimaryDarkBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="12,4">
                <TextBlock Grid.Column="0" Name="LoggedInUserText" Text="Login sebagai: (belum terhubung)"
                           Foreground="{DynamicResource ThemeOnPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="ClockText" Text=""
                           Foreground="{DynamicResource ThemeOnPrimaryBrush}" VerticalAlignment="Center" Margin="24,0,0,0" />
                <TextBlock Grid.Column="3" Text="SIMRS Gramedika — rewrite C#/Avalonia"
                           Foreground="#B9C6E8" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>

    <Window.Styles>
        <!-- Button and ToggleButton don't share a common styled base in Avalonia's
             selector grammar, so the "shortcut" look is declared once per type. -->
        <Style Selector="Button.shortcut, ToggleButton.shortcut">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.shortcut:pointerover /template/ ContentPresenter, ToggleButton.shortcut:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A4FA8" />
        </Style>
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A4FA8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#E81123" />
        </Style>
        <Style Selector="Button.shortcut2">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.shortcut2.accent">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="Button.shortcut2:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}" />
        </Style>
        <Style Selector="Button.menuTile">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>
</Window>
