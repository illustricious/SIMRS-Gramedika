<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:data="using:SimrsKhanza.Data" x:Class="SimrsKhanza.UI.Modules.Farmasi.NoResepView" Background="{DynamicResource ThemeBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto,2*,Auto,*,Auto" Margin="10" RowSpacing="6">
    <TextBlock Classes="pageTitle" Text="No. Resep" />
    <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <TextBlock Text="No. Rawat:" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Name="RawatBox" Width="150" Margin="0,0,8,0" PlaceholderText="No. rawat"/>
      <TextBlock Text="Dokter:" VerticalAlignment="Center" Margin="0,0,4,0"/><ComboBox Name="DokterBox" Width="190" Margin="0,0,8,0"/>
      <TextBlock Text="Tanggal:" VerticalAlignment="Center" Margin="0,0,4,0"/><CalendarDatePicker Name="TanggalBox" Margin="0,0,8,0"/>
      <TextBlock Text="Jam:" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Name="JamBox" Width="80" Margin="0,0,8,0"/>
      <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,4,0"/><ComboBox Name="StatusBox" Width="90" SelectedIndex="0"><ComboBoxItem Content="ralan"/><ComboBoxItem Content="ranap"/></ComboBox>
      <Button Content="💾 Simpan" Click="OnSimpan" Margin="8,0,0,0"/>
    </WrapPanel>
    <WrapPanel Grid.Row="2" Orientation="Horizontal">
      <TextBlock Text="Periode:" VerticalAlignment="Center" Margin="0,0,4,0"/><CalendarDatePicker Name="FromBox"/><TextBlock Text="s.d." VerticalAlignment="Center" Margin="6,0"/><CalendarDatePicker Name="ToBox"/>
      <TextBlock Text="Kata kunci:" VerticalAlignment="Center" Margin="12,0,4,0"/><TextBox Name="CariBox" Width="180"/><Button Content="🔎 Cari" Click="OnCari" Margin="6,0"/>
    </WrapPanel>
    <DataGrid Grid.Row="3" Name="ResepGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column" SelectionChanged="OnPilih" x:DataType="data:NoResepRow">
      <DataGrid.Columns><DataGridTextColumn Header="No. Resep" Binding="{Binding NoResep}" Width="130"/><DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/><DataGridTextColumn Header="Jam" Binding="{Binding Jam}" Width="90"/><DataGridTextColumn Header="No. Rawat" Binding="{Binding NoRawat}" Width="150"/><DataGridTextColumn Header="No. RM" Binding="{Binding NoRm}" Width="100"/><DataGridTextColumn Header="Pasien" Binding="{Binding Pasien}" Width="*" MinWidth="150"/><DataGridTextColumn Header="Dokter" Binding="{Binding Dokter}" Width="*" MinWidth="150"/></DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" Text="Rincian obat yang diberikan" FontWeight="SemiBold"/>
    <DataGrid Grid.Row="5" Name="ObatGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" HeadersVisibility="Column" x:DataType="data:NoResepObatRow">
      <DataGrid.Columns><DataGridTextColumn Header="Nama Obat" Binding="{Binding Obat}" Width="*" MinWidth="160"/><DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80"/><DataGridTextColumn Header="Harga" Binding="{Binding Harga}" Width="100"/><DataGridTextColumn Header="Embalase" Binding="{Binding Embalase}" Width="90"/><DataGridTextColumn Header="Tuslah" Binding="{Binding Tuslah}" Width="90"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="110"/><DataGridTextColumn Header="Aturan Pakai" Binding="{Binding Aturan}" Width="*" MinWidth="140"/></DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8"><Button Content="❌ Keluar" Click="OnBack"/><TextBlock Name="Pesan" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
  </Grid>
</UserControl>
