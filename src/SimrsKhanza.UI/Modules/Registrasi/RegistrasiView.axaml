<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             x:Class="SimrsKhanza.UI.Modules.Registrasi.RegistrasiView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        Layout cross-checked against TWO screenshots the user shared:
        1. "Registrasi Periksa Hari Ini" — collapsible "Input Data" input
           block (toggle = the green-circled icon), Simpan/Baru/Ganti/Hapus/
           Cetak/Semua/Keluar action bar.
        2. "Daftar Pasien Rawat Jalan" — a search row (No.Rawat/No.Reg/
           No.R.M./Nama Pasien), two tabs ("Registrasi Awal" / "Rujukan
           Internal Poli"), and a wide grid (Kode Dokter, Dokter Dituju,
           No.RM, Pasien, Poliklinik, Penanggung Jawab, Alamat P.J.,
           Hubungan P.J., Biaya Reg, Jenis Bayar, Status, No.Rawat, Tanggal,
           Jam, No.Reg, Status Bayar, Stts Poli, No.Telp Pasien).
        Both turned out to be the same screen (this one) at different zoom/
        scroll — merged here instead of building two near-duplicate pages.

        Embedded into MainWindow's content area (not a separate Window), per
        earlier feedback: "Registrasi" swaps the page in place. "Kembali ke
        Menu" means back to the dashboard, not app exit.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" Text=":: [ Registrasi / Daftar Pasien Rawat Jalan ] ::" FontSize="15"
                   Foreground="{DynamicResource ThemePrimaryBrush}" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Spacing="0">
            <!-- Collapsible top input block -->
            <Border Name="InputDataPanel" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                    Background="{DynamicResource ThemeSurfaceBrush}" Padding="12" CornerRadius="4" Margin="0,0,0,4">
                <Grid ColumnDefinitions="Auto,*,24,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="No.Rekam Medik :" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="InputNoRekamMedisBox" Width="160"
                              HorizontalAlignment="Left" Margin="4" PlaceholderText="contoh: D00001" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Penanggung Jawab :" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="0" Grid.Column="4" Name="InputPenanggungJawabBox" Margin="4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Dr Dituju :" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox Grid.Row="1" Grid.Column="1" Name="InputDokterCombo" Margin="4" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Alamat P.J. :" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox Grid.Row="1" Grid.Column="4" Name="InputAlamatPjBox" Margin="4" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Unit / Poli :" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Name="InputPoliCombo" Margin="4" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Jenis Bayar :" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox Grid.Row="2" Grid.Column="4" Name="InputPenjabCombo" Margin="4" HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Name="InputStatusText" Grid.ColumnSpan="5"
                               TextWrapping="Wrap" Margin="4" Foreground="{DynamicResource ThemeAccentBrush}" IsVisible="False" />

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="4,8,4,0" Spacing="8">
                        <Button Name="InputSimpanButton" Content="💾 Simpan" Click="OnInputSimpanClick" />
                        <Button Name="InputBaruButton" Content="🆕 Baru (kosongkan)" Click="OnInputBaruClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Collapse/expand toggle, mirrors the green-circled icon in the user's screenshot -->
            <ToggleButton Name="InputDataToggle" IsChecked="False" Click="OnToggleInputData"
                          HorizontalAlignment="Left" Background="Transparent" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Width="14" Height="14" Fill="{DynamicResource ThemePrimaryLightBrush}" />
                    <TextBlock Text=":: Input Data" FontStyle="Italic"
                               Foreground="{DynamicResource ThemeTextSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </ToggleButton>
        </StackPanel>

        <!-- Search row: No.Rawat / No.Reg / No.R.M. / Nama Pasien -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,24,Auto,*,24,Auto,*,24,Auto,*" Margin="0,4,0,8">
            <TextBlock Grid.Column="0" Text="No. Rawat :" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Name="SearchNoRawatBox" Margin="4,0" />
            <TextBlock Grid.Column="3" Text="No. Reg. :" VerticalAlignment="Center" />
            <TextBox Grid.Column="4" Name="SearchNoRegBox" Margin="4,0" />
            <TextBlock Grid.Column="6" Text="No.R.M. :" VerticalAlignment="Center" />
            <TextBox Grid.Column="7" Name="SearchNoRmBox" Margin="4,0" />
            <TextBlock Grid.Column="9" Text="Nama Pasien :" VerticalAlignment="Center" />
            <TextBox Grid.Column="10" Name="SearchNamaBox" Margin="4,0" />
        </Grid>

        <!-- Tabs: "Registrasi Awal" (implemented) / "Rujukan Internal Poli" (deferred) -->
        <TabControl Grid.Row="3">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Registrasi Awal" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                </TabItem.Header>
                <DataGrid Name="RegistrasiGrid" Margin="0,8" FontSize="12" RowHeight="26"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:RegistrasiListItem">
                    <!-- Star-sized (proportional) instead of fixed pixel widths — columns now
                         auto-fill whatever width the grid has (no horizontal scroll / manual
                         resize needed to "see everything" on a normal window), while keeping
                         roughly the same relative proportions as before. Still user-resizable. -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode Dokter" Binding="{Binding KodeDokter}" Width="0.7*" MinWidth="50" />
                        <DataGridTextColumn Header="Dokter Dituju" Binding="{Binding NamaDokter}" Width="1.1*" MinWidth="70" />
                        <DataGridTextColumn Header="No.RM" Binding="{Binding NoRekamMedis}" Width="0.65*" MinWidth="45" />
                        <DataGridTextColumn Header="Pasien" Binding="{Binding NamaPasien}" Width="1.3*" MinWidth="80" />
                        <DataGridTextColumn Header="Poliklinik" Binding="{Binding NamaPoli}" Width="0.85*" MinWidth="55" />
                        <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding PenanggungJawab}" Width="1.0*" MinWidth="65" />
                        <DataGridTextColumn Header="Alamat P.J." Binding="{Binding AlamatPj}" Width="1.0*" MinWidth="65" />
                        <DataGridTextColumn Header="Hubungan P.J." Binding="{Binding HubunganPj}" Width="0.85*" MinWidth="55" />
                        <DataGridTextColumn Header="Biaya Reg" Binding="{Binding BiayaReg}" Width="0.7*" MinWidth="50" />
                        <DataGridTextColumn Header="Jenis Bayar" Binding="{Binding JenisBayar}" Width="0.85*" MinWidth="55" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.7*" MinWidth="50" />
                        <DataGridTextColumn Header="No.Rawat" Binding="{Binding NoRawat}" Width="1.1*" MinWidth="70" />
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalRegistrasi}" Width="0.75*" MinWidth="55" />
                        <DataGridTextColumn Header="Jam" Binding="{Binding JamRegistrasi}" Width="0.55*" MinWidth="40" />
                        <DataGridTextColumn Header="No.Reg" Binding="{Binding NoReg}" Width="0.55*" MinWidth="40" />
                        <DataGridTextColumn Header="Status Bayar" Binding="{Binding StatusBayar}" Width="0.8*" MinWidth="55" />
                        <DataGridTextColumn Header="Stts Poli" Binding="{Binding StatusPoli}" Width="0.65*" MinWidth="45" />
                        <DataGridTextColumn Header="No.Telp Pasien" Binding="{Binding NoTelpPasien}" Width="0.9*" MinWidth="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Rujukan Internal Poli" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                </TabItem.Header>
                <TextBlock Text="Belum diimplementasikan di tahap scaffold ini." Margin="16"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
            </TabItem>
        </TabControl>

        <!-- Bottom filter + action bar -->
        <StackPanel Grid.Row="4" Spacing="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,24,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="Periode :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <DatePicker Grid.Column="1" Name="PeriodeFromPicker" />
                <TextBlock Grid.Column="2" Text="s.d." VerticalAlignment="Center" Margin="8,0" />
                <DatePicker Grid.Column="3" Name="PeriodeToPicker" />
                <TextBlock Grid.Column="5" Text="Key Word :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Grid.Column="6" Name="KeyWordBox" />
                <TextBlock Grid.Column="7" Name="RecordCountText" Text="Record : 0"
                           VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Simpan/Baru moved into "Input Data" above (where the fields
                     actually are) — real writes now, see OnInputSimpanClick.
                     Ganti/Hapus (edit/delete an EXISTING registration) stay
                     placeholder: riskier to get right against real patient
                     data without a clearer spec, deliberately deferred. -->
                <Button Content="🔁 Ganti" Click="OnPlaceholderClick" />
                <Button Content="🗑 Hapus" Click="OnPlaceholderClick" />
                <Button Content="🩺 Periksa" Click="OnPeriksaClick" />
                <Button Content="🖨 Cetak" Click="OnCetakClick" />
                <Button Content="🔎 Cari / Semua" Click="OnSearchClick" />
                <Button Content="⬅ Kembali ke Menu" Click="OnBackClick" Classes="accentText" HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <!-- Scoped to this screen only (NOT app-wide — an earlier attempt at a
             global zoom via LayoutTransformControl on MainWindow was reverted
             per feedback: shrank everything, not just this admittedly dense
             form+grid screen). Default theme TextBlock/TextBox sizes felt
             oversized given how many fields/columns this screen packs in. -->
        <Style Selector="TextBlock">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBox, DatePicker, ComboBox">
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>
</UserControl>
