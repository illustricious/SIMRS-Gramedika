<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             x:Class="SimrsKhanza.UI.Modules.Registrasi.RegistrasiView"
             Background="{DynamicResource TegasPageBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12" RowSpacing="6">

        <Border Classes="tegasHeading">
            <StackPanel Spacing="1">
                <TextBlock Classes="pageTitle" Text="Registrasi Periksa Hari Ini" />
                <TextBlock Classes="pageSubtitle" Text="Rawat Jalan" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource ThemePanelBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
          <StackPanel>
            <Border Name="InputDataPanel" Padding="10,7"
                    IsVisible="{ReflectionBinding #InputDataToggle.IsChecked, FallbackValue=False, TargetNullValue=False}">
              <StackPanel>
              <Grid ColumnDefinitions="43*,57*" ColumnSpacing="16">
                <Grid ColumnDefinitions="88,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Row="0" Text="No. Reg." VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="InputNoRegBox" IsReadOnly="True" Width="96" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="1" Text="No. Rawat" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Name="InputNoRawatBox" IsReadOnly="True" Width="170" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="2" Text="Tgl. Reg." VerticalAlignment="Center" />
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBox Name="InputTanggalBox" IsReadOnly="True" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="Tanggal registrasi" />
                        <TextBlock Text="Jam" VerticalAlignment="Center" />
                        <TextBox Name="InputJamBox" IsReadOnly="True" Width="76" HorizontalAlignment="Left" AutomationProperties.Name="Jam registrasi" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="Dr. Dituju" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="67,*" ColumnSpacing="6">
                        <TextBox IsReadOnly="True" AutomationProperties.Name="Kode dokter"
                                 Text="{ReflectionBinding #InputDokterCombo.SelectedItem.KodeDokter, FallbackValue=''}" />
                        <ComboBox Grid.Column="1" Name="InputDokterCombo" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="Dokter dituju" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Unit" VerticalAlignment="Center" />
                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="58,*,Auto,Auto" ColumnSpacing="6">
                        <TextBox IsReadOnly="True" AutomationProperties.Name="Kode unit"
                                 Text="{ReflectionBinding #InputPoliCombo.SelectedItem.KodePoli, FallbackValue=''}" />
                        <ComboBox Grid.Column="1" Name="InputPoliCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Unit / Poli" />
                        <TextBlock Grid.Column="2" Text="Biaya" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Name="InputBiayaBox" IsReadOnly="True" Width="88" HorizontalAlignment="Left" AutomationProperties.Name="Biaya registrasi tercatat" />
                    </Grid>
                </Grid>

                <Grid Grid.Column="1" ColumnDefinitions="111,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Row="0" Text="No. Rekam Medik" VerticalAlignment="Center" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="84,*" ColumnSpacing="6">
                        <TextBox Name="InputNoRekamMedisBox" IsReadOnly="True" AutomationProperties.Name="Nomor rekam medis" />
                        <TextBox Grid.Column="1" Name="InputNamaPasienBox" IsReadOnly="True" AutomationProperties.Name="Nama pasien" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Penanggung Jawab" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto,88" ColumnSpacing="6">
                        <TextBox Name="InputPenanggungJawabBox" AutomationProperties.Name="Penanggung jawab" />
                        <TextBlock Grid.Column="1" Text="Hubungan" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Name="InputHubunganBox" AutomationProperties.Name="Hubungan penanggung jawab" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Alamat P.J." VerticalAlignment="Center" />
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,88" ColumnSpacing="6">
                        <TextBox Name="InputAlamatPjBox" AutomationProperties.Name="Alamat penanggung jawab" />
                        <TextBlock Grid.Column="1" Text="Status" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Name="InputStatusDaftarBox" IsReadOnly="True" AutomationProperties.Name="Status pendaftaran" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="Jenis Bayar" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,108" ColumnSpacing="6">
                        <ComboBox Name="InputPenjabCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Jenis bayar" />
                        <TextBlock Grid.Column="1" Text="No. Kartu" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Name="InputNoKartuBox" IsReadOnly="True" AutomationProperties.Name="Nomor kartu" />
                    </Grid>

                    <TextBlock Grid.Row="4" Text="Asal Rujukan" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Name="InputAsalRujukanBox" IsReadOnly="True" AutomationProperties.Name="Asal rujukan" />
                </Grid>
              </Grid>
              <TextBlock Name="InputStatusText" Classes="registrationStatus" TextWrapping="Wrap" Margin="0,3,0,0" IsVisible="False" />
              </StackPanel>
            </Border>
            <ToggleButton Name="InputDataToggle" Classes="inputData" IsChecked="False" Click="OnInputDataClick"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          AutomationProperties.Name="Input Data" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Width="12" Height="8" Stretch="Uniform" StrokeThickness="1.7"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          Stroke="{DynamicResource ThemeIconBrush}" Data="M2,2 L7,7 L12,2" />
                    <TextBlock Text="Input Data" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
          </StackPanel>
        </Border>

        <!-- Tabs: "Registrasi Awal" (implemented) / "Rujukan Internal Poli" (deferred) -->
        <TabControl Grid.Row="2" Background="{DynamicResource ThemePanelBrush}" Padding="4,0,4,4">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Registrasi Awal" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                </TabItem.Header>
                <DataGrid Name="RegistrasiGrid" Classes="compactColumns" Margin="0,2,0,0"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          x:DataType="data:RegistrasiListItem" SelectionChanged="OnRegistrasiSelected">
                    <!-- Star-sized (proportional) instead of fixed pixel widths — columns now
                         auto-fill whatever width the grid has (no horizontal scroll / manual
                         resize needed to "see everything" on a normal window), while keeping
                         roughly the same relative proportions as before. Still user-resizable. -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Reg" Binding="{Binding NoReg}" Width="0.5*" MinWidth="72" />
                        <DataGridTextColumn Header="No. Rawat" Binding="{Binding NoRawat}" Width="1.1*" MinWidth="148" />
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalRegistrasi}" Width="0.75*" MinWidth="95" />
                        <DataGridTextColumn Header="Jam" Binding="{Binding JamRegistrasi}" Width="0.55*" MinWidth="66" />
                        <DataGridTextColumn Header="Kode Dokter" Binding="{Binding KodeDokter}" Width="0.7*" MinWidth="60" />
                        <DataGridTextColumn Header="Dokter Dituju" Binding="{Binding NamaDokter}" Width="1.3*" MinWidth="140" />
                        <DataGridTextColumn Header="Nomer RM" Binding="{Binding NoRekamMedis}" Width="0.65*" MinWidth="60" />
                        <DataGridTextColumn Header="Pasien" Binding="{Binding NamaPasien}" FontWeight="SemiBold" Width="1.3*" MinWidth="136" />
                        <DataGridTextColumn Header="J.K." Binding="{Binding JenisKelamin}" Width="0.3*" MinWidth="30" />
                        <DataGridTextColumn Header="Umur" Binding="{Binding Umur}" Width="0.5*" MinWidth="45" />
                        <DataGridTextColumn Header="Poliklinik" Binding="{Binding NamaPoli}" Width="1.0*" MinWidth="128" />
                        <DataGridTextColumn Header="Jenis Bayar" Binding="{Binding JenisBayar}" Width="0.8*" MinWidth="70" />
                        <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding PenanggungJawab}" Width="1.0*" MinWidth="90" />
                        <DataGridTextColumn Header="Alamat P.J." Binding="{Binding AlamatPj}" Width="1.0*" MinWidth="90" />
                        <DataGridTextColumn Header="Hubungan P.J." Binding="{Binding HubunganPj}" Width="0.8*" MinWidth="75" />
                        <DataGridTextColumn Header="Biaya Registrasi" Binding="{Binding BiayaReg}" Width="0.7*" MinWidth="70" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.6*" MinWidth="50" />
                        <DataGridTextColumn Header="No.Telp" Binding="{Binding NoTelpPasien}" Width="0.8*" MinWidth="70" />
                        <DataGridTextColumn Header="Stts Rawat" Binding="{Binding StatusRawat}" Width="0.55*" MinWidth="55" />
                        <DataGridTextColumn Header="Stts Poli" Binding="{Binding StatusPoli}" Width="0.5*" MinWidth="50" />
                        <DataGridTextColumn Header="Kode Poli" Binding="{Binding KodePoli}" Width="0.5*" MinWidth="55" />
                        <DataGridTextColumn Header="Kode PJ" Binding="{Binding KodePj}" Width="0.45*" MinWidth="50" />
                        <DataGridTextColumn Header="Status Bayar" Binding="{Binding StatusBayar}" Width="0.75*" MinWidth="75" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Rujukan Internal Poli" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                </TabItem.Header>
                <TextBlock Text="Rujukan internal poli belum tersedia." Classes="pageSubtitle" Margin="16" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{DynamicResource ThemePanelBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,6">
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="72,*,Auto,*">
                    <TextBlock Text="Dokter" Classes="pageSubtitle" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Name="FilterDokterCombo" HorizontalAlignment="Stretch"
                              PlaceholderText="Semua dokter" AutomationProperties.Name="Filter dokter" />
                    <TextBlock Grid.Column="2" Text="Unit" Classes="pageSubtitle"
                               Margin="20,0,12,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="3" Name="FilterPoliCombo" HorizontalAlignment="Stretch"
                              PlaceholderText="Semua unit" AutomationProperties.Name="Filter unit" />
                </Grid>
                <Grid ColumnDefinitions="72,Auto,Auto,Auto,Auto,*,Auto">
                    <TextBlock Text="Periode" Classes="pageSubtitle" VerticalAlignment="Center" />
                    <CalendarDatePicker Grid.Column="1" Name="PeriodeFromPicker" AutomationProperties.Name="Dari tanggal" />
                    <TextBlock Grid.Column="2" Text="s.d." Classes="pageSubtitle" VerticalAlignment="Center" Margin="8,0" />
                    <CalendarDatePicker Grid.Column="3" Name="PeriodeToPicker" AutomationProperties.Name="Sampai tanggal" />
                    <TextBlock Grid.Column="4" Text="Kata kunci" Classes="pageSubtitle" VerticalAlignment="Center" Margin="16,0,8,0" />
                    <TextBox Grid.Column="5" Name="KeyWordBox" PlaceholderText="No. rawat, no. RM, atau nama pasien"
                             AutomationProperties.Name="Cari registrasi" />
                    <Button Grid.Column="6" Content="Cari" Classes="accent" Click="OnSearchClick" Margin="8,0,0,0" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                        <Button Name="InputSimpanButton" Content="Simpan" Classes="accent"
                                IsEnabled="{ReflectionBinding #InputDataToggle.IsChecked, FallbackValue=False, TargetNullValue=False}"
                                Click="OnInputSimpanClick" />
                        <Button Content="Hapus" Foreground="{DynamicResource ThemeAccentBrush}" Click="OnPlaceholderClick" />
                        <Button Content="Cetak" Click="OnCetakClick" />
                        <Button Content="Semua" Click="OnSemuaClick" />
                        <Button Content="Periksa" Click="OnPeriksaClick" />
                        <TextBlock Name="RecordCountText" Text="0 registrasi" Classes="pageSubtitle"
                                   Margin="4,0,0,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <Button Grid.Column="1" Content="Kembali ke Menu" Click="OnBackClick" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

</UserControl>
