<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             x:Class="SimrsKhanza.UI.Modules.Laporan.LaporanKunjunganView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text=":: [ Laporan Kunjungan ] ::"
                   Foreground="{DynamicResource ThemePrimaryBrush}" FontWeight="Bold" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="Periode :" VerticalAlignment="Center" />
            <DatePicker Name="FromPicker" />
            <TextBlock Text="s.d." VerticalAlignment="Center" />
            <DatePicker Name="ToPicker" />
            <Button Content="🔎 Tampilkan" Click="OnTampilkanClick" />
            <TextBlock Name="RingkasanText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        </StackPanel>

        <DataGrid Grid.Row="2" Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                  x:DataType="data:RegistrasiListItem">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No.Rawat" Binding="{Binding NoRawat}" Width="150" />
                <DataGridTextColumn Header="Pasien" Binding="{Binding NamaPasien}" Width="*" />
                <DataGridTextColumn Header="Poliklinik" Binding="{Binding NamaPoli}" Width="110" />
                <DataGridTextColumn Header="Dokter Dituju" Binding="{Binding NamaDokter}" Width="130" />
                <DataGridTextColumn Header="Jenis Bayar" Binding="{Binding JenisBayar}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalRegistrasi}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
