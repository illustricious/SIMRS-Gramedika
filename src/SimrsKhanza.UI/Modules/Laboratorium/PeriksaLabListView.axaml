<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             xmlns:local="using:SimrsKhanza.UI.Modules.Laboratorium"
             x:Class="SimrsKhanza.UI.Modules.Laboratorium.PeriksaLabListView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        Legacy DlgCariPeriksaLab / ...PA / ...MB — "Data Pemeriksaan Laboratorium {kategori}".
        PK/MB: tab "Data Pemeriksaan" (visit header row + nested pemeriksaan/item rows, exactly how the
        legacy grid builds them) and tab "Item Pemeriksaan" (flat). PA: one flat row per pemeriksaan
        with the narrative fields, editable in the panel below. Legacy's third tab ("Detail
        Kunjungan", an HTML summary) is not ported.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="10">
        <TextBlock Grid.Row="0" Name="TitleText" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}" Margin="0,0,0,6" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,170,16,Auto,Auto,Auto,Auto,16,Auto,100,16,Auto,200" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="No.Rawat :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Name="NoRawatBox" KeyUp="OnFilterKeyUp" />
            <TextBlock Grid.Column="3" Text="Tanggal :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <CalendarDatePicker Grid.Column="4" Name="FromPicker" />
            <TextBlock Grid.Column="5" Text="s.d." VerticalAlignment="Center" Margin="6,0" />
            <CalendarDatePicker Grid.Column="6" Name="ToPicker" />
            <TextBlock Grid.Column="8" Text="Pasien :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="9" Name="NoRmBox" PlaceholderText="No.RM" KeyUp="OnFilterKeyUp" />
            <TextBlock Grid.Column="11" Text="Petugas :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="12" Name="PetugasCombo" HorizontalAlignment="Stretch" />
        </Grid>

        <TabControl Grid.Row="2" Name="Tabs">
            <TabItem Header="Data Pemeriksaan">
                <Grid>
                    <DataGrid Name="NestedGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                              HeadersVisibility="Column" CanUserResizeColumns="True" FontSize="11" RowHeight="22"
                              x:DataType="local:LabDisplayRow" SelectionChanged="OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No.Rawat" Binding="{Binding C0}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="Pasien" Binding="{Binding C1}" Width="2.2*" MinWidth="200" />
                            <DataGridTextColumn Header="Petugas" Binding="{Binding C2}" Width="1.5*" MinWidth="120" />
                            <DataGridTextColumn Header="Tgl.Periksa" Binding="{Binding C3}" Width="0.8*" MinWidth="80" />
                            <DataGridTextColumn Header="Jam Periksa" Binding="{Binding C4}" Width="0.7*" MinWidth="70" />
                            <DataGridTextColumn Header="Dokter Perujuk" Binding="{Binding C5}" Width="1.5*" MinWidth="120" />
                            <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding C6}" Width="1.5*" MinWidth="120" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid Name="PaGrid" IsVisible="False" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                              HeadersVisibility="Column" CanUserResizeColumns="True" FontSize="11" RowHeight="22"
                              x:DataType="data:LabPeriksaPaRow" SelectionChanged="OnSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No.Rawat" Binding="{Binding NoRawat}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="Pasien" Binding="{Binding PasienText}" Width="2.2*" MinWidth="200" />
                            <DataGridTextColumn Header="Petugas" Binding="{Binding Petugas}" Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="Tgl.Periksa" Binding="{Binding Tgl}" Width="0.8*" MinWidth="80" />
                            <DataGridTextColumn Header="Jam Periksa" Binding="{Binding Jam}" Width="0.7*" MinWidth="70" />
                            <DataGridTextColumn Header="Dokter Perujuk" Binding="{Binding DokterPerujuk}" Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding DokterPj}" Width="1.3*" MinWidth="110" />
                            <DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Pemeriksaan}" Width="1.6*" MinWidth="140" />
                            <DataGridTextColumn Header="Biaya" Binding="{Binding Biaya, StringFormat={}{0:N0}}" Width="0.6*" MinWidth="60" />
                            <DataGridTextColumn Header="Diagnosa Klinis" Binding="{Binding DiagnosaKlinik}" Width="1.2*" MinWidth="100" />
                            <DataGridTextColumn Header="Makroskopik" Binding="{Binding Makroskopik}" Width="1.4*" MinWidth="110" />
                            <DataGridTextColumn Header="Mikroskopik" Binding="{Binding Mikroskopik}" Width="1.4*" MinWidth="110" />
                            <DataGridTextColumn Header="Kesimpulan" Binding="{Binding Kesimpulan}" Width="1.2*" MinWidth="100" />
                            <DataGridTextColumn Header="Kesan" Binding="{Binding Kesan}" Width="1.2*" MinWidth="100" />
                            <DataGridTextColumn Header="Kode Periksa" Binding="{Binding KdJenisPrw}" Width="0.7*" MinWidth="70" />
                            <DataGridTextColumn Header="Cara Bayar" Binding="{Binding CaraBayar}" Width="1*" MinWidth="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Name="ItemTab" Header="Item Pemeriksaan">
                <DataGrid Name="ItemGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                          HeadersVisibility="Column" CanUserResizeColumns="True" FontSize="11" RowHeight="22"
                          x:DataType="local:LabItemRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No.Rawat" Binding="{Binding NoRawat}" Width="1.1*" MinWidth="110" />
                        <DataGridTextColumn Header="Pasien" Binding="{Binding Pasien}" Width="2*" MinWidth="180" />
                        <DataGridTextColumn Header="Tgl.Periksa" Binding="{Binding Tgl}" Width="0.8*" MinWidth="80" />
                        <DataGridTextColumn Header="Jam" Binding="{Binding Jam}" Width="0.6*" MinWidth="60" />
                        <DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Pemeriksaan}" Width="1.5*" MinWidth="130" />
                        <DataGridTextColumn Header="Item Pemeriksaan" Binding="{Binding Item}" Width="1.5*" MinWidth="130" />
                        <DataGridTextColumn Header="Hasil" Binding="{Binding Hasil}" Width="0.8*" MinWidth="70" />
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="0.6*" MinWidth="60" />
                        <DataGridTextColumn Header="Nilai Rujukan" Binding="{Binding NilaiRujukan}" Width="0.9*" MinWidth="80" />
                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="1*" MinWidth="80" />
                        <DataGridTextColumn Header="Ruang" Binding="{Binding Ruang}" Width="1*" MinWidth="90" />
                        <DataGridTextColumn Header="Petugas" Binding="{Binding Petugas}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="Dokter Perujuk" Binding="{Binding DokterPerujuk}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding DokterPj}" Width="1.2*" MinWidth="110" />
                        <DataGridTextColumn Header="Metode" Binding="{Binding Metode}" Width="0.8*" MinWidth="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- PK/MB: the legacy "Kesan & Saran" window; PA: the narrative editor -->
        <Border Grid.Row="3" Name="KesanPanel" IsVisible="False" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}" Padding="8" CornerRadius="4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*,16,Auto,*,16,Auto">
                <TextBlock Grid.Column="0" Text="Kesan :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Column="1" Name="KesanBox" AcceptsReturn="True" Height="48" MaxLength="700" />
                <TextBlock Grid.Column="3" Text="Saran :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Column="4" Name="SaranBox" AcceptsReturn="True" Height="48" MaxLength="700" />
                <Button Grid.Column="6" Content="💾 Update Kesan &amp; Saran" Click="OnUpdateKesanClick" VerticalAlignment="Top" />
            </Grid>
        </Border>
        <Border Grid.Row="3" Name="PaPanel" IsVisible="False" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}" Padding="8" CornerRadius="4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*,12,Auto,*,12,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Diagnosa Klinis :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="PaDiagnosaBox" AcceptsReturn="True" Height="46" MaxLength="50" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Makroskopik :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Row="0" Grid.Column="4" Name="PaMakroBox" AcceptsReturn="True" Height="46" MaxLength="1024" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mikroskopik :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Name="PaMikroBox" AcceptsReturn="True" Height="46" MaxLength="1024" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Kesimpulan :" VerticalAlignment="Top" Margin="0,8,4,0" />
                <TextBox Grid.Row="1" Grid.Column="4" Name="PaKesimpulanBox" AcceptsReturn="True" Height="46" MaxLength="300" Margin="0,4,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Spacing="4">
                    <TextBlock Text="Kesan :" />
                    <TextBox Name="PaKesanBox" AcceptsReturn="True" Height="46" Width="200" MaxLength="300" />
                    <Button Content="💾 Update" Click="OnUpdatePaClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Key Word :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Name="KeywordBox" KeyUp="OnFilterKeyUp" MaxWidth="300" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="2" Name="RecordText" Text="Record : 0" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Column="3" Name="TotalText" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="🔍 Cari" Click="OnCariClick" />
            <Button Content="🧪 Periksa Baru" Click="OnInputClick" />
            <Button Content="🗑 Hapus" Click="OnHapusClick" />
            <Button Content="📋 Semua" Click="OnSemuaClick" />
            <Button Content="🖨 Cetak" Click="OnCetakClick" />
            <Button Content="❌ Keluar" Click="OnBackClick" Classes="accentText" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="TextBlock"><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
<Style Selector="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Styles>
</UserControl>
