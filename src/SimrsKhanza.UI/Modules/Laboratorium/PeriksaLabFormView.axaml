<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SimrsKhanza.UI.Modules.Laboratorium"
             x:Class="SimrsKhanza.UI.Modules.Laboratorium.PeriksaLabFormView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        Legacy DlgPeriksaLaboratorium / ...PA / ...MB — "Input Data Hasil Periksa Laboratorium {kategori}".
        Left: pemeriksaan (jns_perawatan_lab) to tick; right: detail to fill in — template items with
        Hasil/Nilai Rujukan/Keterangan for PK/MB, the five narrative fields for PA.
        Not ported: Nota, Cetak lembar hasil, Hapus on this form, LIS/analyzer imports (Sysmex, LICA, ...).
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="10">
        <TextBlock Grid.Row="0" Name="TitleText" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}" Margin="0,0,0,6" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}" Padding="8" CornerRadius="4">
            <Grid ColumnDefinitions="Auto,*,16,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="No.Rawat :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="200,Auto,*">
                    <TextBox Name="NoRawatBox" KeyUp="OnNoRawatKeyUp" PlaceholderText="2026/11/09/000001" />
                    <Button Grid.Column="1" Content="🔍 Muat" Click="OnMuatClick" Margin="4,0,0,0" />
                    <TextBlock Grid.Column="2" Name="PasienText" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Medium" />
                </Grid>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Dokter Perujuk :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <ComboBox Grid.Row="0" Grid.Column="4" Name="PerujukCombo" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Info :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Name="InfoText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Dokter P.J. :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <ComboBox Grid.Row="1" Grid.Column="4" Name="PjCombo" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tanggal :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <DatePicker Name="TanggalPicker" />
                    <TextBlock Text="Jam :" VerticalAlignment="Center" />
                    <TextBox Name="JamBox" Width="80" MaxLength="8" />
                    <Button Content="Sekarang" Click="OnSekarangClick" />
                    <RadioButton Name="RbDewasa" GroupName="Umur" Content="Dewasa" IsChecked="True" Click="OnUmurRadioClick" Margin="12,0,0,0" />
                    <RadioButton Name="RbAnak" GroupName="Umur" Content="Anak-Anak" Click="OnUmurRadioClick" />
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="Petugas :" VerticalAlignment="Center" Margin="0,2,6,2" />
                <ComboBox Grid.Row="2" Grid.Column="4" Name="PetugasCombo" HorizontalAlignment="Stretch" PlaceholderText="pilih petugas" />

                <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Name="OrderText" Margin="0,4,0,0" IsVisible="False"
                           Foreground="{DynamicResource ThemeAccentBrush}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,260,Auto,Auto" Margin="0,6,0,4">
            <TextBlock Grid.Column="0" Text="Pemeriksaan :" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Name="CariBox" KeyUp="OnCariKeyUp" />
            <Button Grid.Column="2" Content="🔍 Cari" Click="OnCariClick" Margin="4,0,0,0" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="380,8,*">
            <DataGrid Grid.Column="0" Name="TarifGrid" AutoGenerateColumns="False" GridLinesVisibility="All" HeadersVisibility="Column"
                      FontSize="11" RowHeight="24" CanUserResizeColumns="True" x:DataType="local:TarifPick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="P" Width="36">
                        <DataTemplate x:DataType="local:TarifPick">
                            <CheckBox IsChecked="{Binding Dipilih, Mode=TwoWay}" HorizontalAlignment="Center" MinHeight="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kode Periksa" Binding="{Binding Kode}" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn Header="Nama Pemeriksaan" Binding="{Binding Nama}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="Tarif" Binding="{Binding BiayaText}" IsReadOnly="True" Width="80" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="2">
                <DataGrid Name="DetailGrid" AutoGenerateColumns="False" GridLinesVisibility="All" HeadersVisibility="Column"
                          FontSize="11" RowHeight="26" CanUserResizeColumns="True" x:DataType="local:LabDetailRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="P" Width="36">
                            <DataTemplate x:DataType="local:LabDetailRow">
                                <CheckBox IsChecked="{Binding Dipilih, Mode=TwoWay}" IsVisible="{Binding IsItem}" HorizontalAlignment="Center" MinHeight="0" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Nama}" IsReadOnly="True" Width="2*" MinWidth="170" />
                        <DataGridTemplateColumn Header="Hasil" Width="1.2*" MinWidth="110">
                            <DataTemplate x:DataType="local:LabDetailRow">
                                <TextBox Text="{Binding Hasil, Mode=TwoWay}" IsVisible="{Binding IsItem}" MaxLength="200" MinHeight="20" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" IsReadOnly="True" Width="0.6*" MinWidth="60" />
                        <DataGridTemplateColumn Header="Nilai Rujukan" Width="1*" MinWidth="100">
                            <DataTemplate x:DataType="local:LabDetailRow">
                                <TextBox Text="{Binding NilaiRujukan, Mode=TwoWay}" IsVisible="{Binding IsItem}" MaxLength="30" MinHeight="20" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Metode" Binding="{Binding Metode}" IsReadOnly="True" Width="0.6*" MinWidth="60" />
                        <DataGridTemplateColumn Header="Keterangan" Width="1.2*" MinWidth="110">
                            <DataTemplate x:DataType="local:LabDetailRow">
                                <TextBox Text="{Binding Keterangan, Mode=TwoWay}" IsVisible="{Binding IsItem}" MaxLength="60" MinHeight="20" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Biaya Item" Binding="{Binding BiayaText}" IsReadOnly="True" Width="0.6*" MinWidth="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid Name="PaDetailGrid" IsVisible="False" AutoGenerateColumns="False" GridLinesVisibility="All" HeadersVisibility="Column"
                          FontSize="11" CanUserResizeColumns="True" x:DataType="local:PaRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Nama}" IsReadOnly="True" Width="1.4*" MinWidth="130" />
                        <DataGridTemplateColumn Header="Diagnosa Klinis" Width="1.2*" MinWidth="110">
                            <DataTemplate x:DataType="local:PaRow">
                                <TextBox Text="{Binding DiagnosaKlinik, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="50" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Makroskopik" Width="1.6*" MinWidth="130">
                            <DataTemplate x:DataType="local:PaRow">
                                <TextBox Text="{Binding Makroskopik, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="1024" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Mikroskopik" Width="1.6*" MinWidth="130">
                            <DataTemplate x:DataType="local:PaRow">
                                <TextBox Text="{Binding Mikroskopik, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="1024" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Kesimpulan" Width="1.2*" MinWidth="110">
                            <DataTemplate x:DataType="local:PaRow">
                                <TextBox Text="{Binding Kesimpulan, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="300" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Kesan" Width="1.2*" MinWidth="110">
                            <DataTemplate x:DataType="local:PaRow">
                                <TextBox Text="{Binding Kesan, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="300" Padding="4,1" />
                            </DataTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <TextBlock Name="TotalText" Text="Total Biaya : 0" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="💾 Simpan" Click="OnSimpanClick" />
            <Button Content="🆕 Baru" Click="OnBaruClick" />
            <Button Content="❌ Keluar" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="TextBlock"><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="TextBox, ComboBox">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="DatePicker">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </UserControl.Styles>
</UserControl>
