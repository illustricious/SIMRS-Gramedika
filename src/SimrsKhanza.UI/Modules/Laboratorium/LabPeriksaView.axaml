<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             x:Class="SimrsKhanza.UI.Modules.Laboratorium.LabPeriksaView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- Single-purpose: antrian menunggu hasil + input hasil, for one kategori
         (PK/PA/MB), reached from a LabMenuView tile. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Grid.Row="0" Name="TitleText" Foreground="{DynamicResource ThemePrimaryBrush}"
                   FontWeight="Bold" Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="2*,16,3*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Menunggu Hasil" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <DataGrid Grid.Row="1" Name="AntrianGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:PenunjangAntrianItem" SelectionChanged="OnAntrianSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No.Rawat" Binding="{Binding NoRawat}" Width="140" />
                        <DataGridTextColumn Header="Nama Pasien" Binding="{Binding NamaPasien}" Width="*" />
                        <DataGridTextColumn Header="Dokter Perujuk" Binding="{Binding DokterPerujuk}" Width="110" />
                        <DataGridTextColumn Header="Tgl Permintaan" Binding="{Binding TanggalPermintaan}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="14"
                    VerticalAlignment="Top">
                <StackPanel Spacing="4">
                    <TextBlock Name="SelectedText" Text="(belum ada pasien dipilih dari antrian)"
                               FontWeight="Medium" Foreground="{DynamicResource ThemeTextBrush}" />
                    <TextBlock Text="Kesan :" Margin="0,4,0,0" />
                    <TextBox Name="KesanBox" AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                    <TextBlock Text="Saran :" Margin="0,4,0,0" />
                    <TextBox Name="SaranBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                    <TextBlock Name="HasilStatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeAccentBrush}" IsVisible="False" />
                    <Button Name="SimpanHasilButton" Content="💾 Simpan Hasil" Click="OnSimpanHasilClick"
                            HorizontalAlignment="Left" Margin="0,4,0,0" IsEnabled="False" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
