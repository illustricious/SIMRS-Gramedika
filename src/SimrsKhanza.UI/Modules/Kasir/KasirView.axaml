<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsKhanza.UI.Modules.Kasir.KasirView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        Kasir / Billing: look up one visit by No.Rawat, see the breakdown
        (biaya registrasi + biaya kamar inap jika rawat inap) and total, then
        mark it paid (real write to reg_periksa.status_bayar). Deliberately
        simple — no cash drawer / change calculation, just the tagihan lookup
        the legacy "Kasir Rawat Jalan/Inap" screens center around.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" Text=":: [ Kasir — Tagihan Pasien ] ::"
                   Foreground="{DynamicResource ThemePrimaryBrush}" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="No. Rawat :" VerticalAlignment="Center" />
            <TextBox Name="NoRawatBox" Width="260" PlaceholderText="contoh: 2026/11/07/000001" />
            <Button Content="🔍 Cari Tagihan" Click="OnCariClick" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="14" Margin="0,10,0,0"
                VerticalAlignment="Top">
            <StackPanel Spacing="6" Name="BillPanel" IsVisible="False">
                <TextBlock Name="PatientText" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBrush}" />
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Biaya Registrasi" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Name="BiayaRegText" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Biaya Kamar (Rawat Inap)" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="BiayaKamarText" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Tagihan" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Name="TotalText" FontWeight="Bold" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Status Bayar" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Name="StatusBayarText" />
                </Grid>
                <Button Name="BayarButton" Content="💰 Tandai Lunas" Click="OnBayarClick"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Name="NotFoundText" Text="" Foreground="{DynamicResource ThemeAccentBrush}"
                   Margin="0,10,0,0" VerticalAlignment="Top" IsVisible="False" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali ke Menu" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
