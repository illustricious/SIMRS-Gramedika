<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Data"
             x:Class="SimrsKhanza.UI.Modules.Kasir.KasirView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <TextBlock Classes="pageTitle" Grid.Row="0" Text="Kasir — Tagihan Pasien"
                   Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="No. Rawat :" VerticalAlignment="Center" />
            <TextBox Name="NoRawatBox" Width="260" PlaceholderText="contoh: 2026/11/07/000001" KeyDown="OnNoRawatKeyDown" />
            <Button Name="CariButton" Content="🔍 Cari Tagihan" Click="OnCariClick" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
          <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="14" VerticalAlignment="Top">
            <StackPanel Spacing="8">
            <TextBlock Name="NotFoundText" Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap" IsVisible="False" />
            <StackPanel Spacing="6" Name="BillPanel" IsVisible="False">
                <TextBlock Name="PatientText" Classes="sectionTitle" />
                <DataGrid Name="RincianGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="360" GridLinesVisibility="All" HeadersVisibility="Column" x:DataType="data:KasirRincian">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="130"/>
                        <DataGridTextColumn Header="Rincian" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Tarif (Rp)" Binding="{Binding Tarif, StringFormat='#,0.####'}" Width="125"/>
                        <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah, StringFormat=0.####}" Width="80"/>
                        <DataGridTextColumn Header="Total (Rp)" Binding="{Binding Total, StringFormat='#,0.####'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto">
                    <TextBlock Name="TotalLabel" Text="Total Rincian" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Name="TotalText" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="Status Bayar" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="StatusBayarText" />
                </Grid>
                <StackPanel Name="RincianLayananPanel" Spacing="6" Margin="0,8,0,0" IsVisible="False">
                    <TextBlock Text="Rincian Tindakan dan Obat &amp; BHP" Classes="sectionTitle" />
                    <DataGrid Name="RincianLayananGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              MaxHeight="260" GridLinesVisibility="All" HeadersVisibility="Column" x:DataType="data:KasirRincian">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="165"/>
                            <DataGridTextColumn Header="Rincian" Binding="{Binding Nama}" Width="*"/>
                            <DataGridTextColumn Header="Tarif (Rp)" Binding="{Binding Tarif, StringFormat='#,0.####'}" Width="115"/>
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah, StringFormat=0.####}" Width="80"/>
                            <DataGridTextColumn Header="Total (Rp)" Binding="{Binding Total, StringFormat='#,0.####'}" Width="115"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="Subtotal Tindakan dan Obat" FontWeight="Bold" />
                        <TextBlock Grid.Column="1" Name="SubtotalLayananText" FontWeight="Bold" />
                    </Grid>
                    <TextBlock Text="Subtotal berasal dari transaksi layanan. Total obat mencakup embalase dan tuslah yang tercatat. Pelunasan dilakukan di Kasir Khanza."
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Name="AkunBayarRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <TextBlock Text="Akun Bayar" VerticalAlignment="Center" />
                    <ComboBox Name="AkunBayarBox" MinWidth="240" PlaceholderText="Pilih akun bayar" />
                </StackPanel>
                <Button Name="BayarButton" Content="Tandai Lunas" Click="OnBayarClick"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                <Button Name="BuktiButton" Content="Simpan Bukti Pelunasan PDF" Click="OnBuktiClick"
                        HorizontalAlignment="Left" IsVisible="False" />
            </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali ke Menu" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
