<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsKhanza.Core.Entities"
             x:Class="SimrsKhanza.UI.Modules.Pasien.PasienView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        "Identitas Pasien" — core field set cross-checked against the legacy
        src/simrskhanza/DlgPasien.form (NetBeans form XML). The dialog there
        also bundles BPJS/Dukcapil/SatuSehat web lookups, ~15 print-letter
        shortcuts, a TNI/POLRI sub-panel, and cascading kelurahan/kecamatan/
        kabupaten/propinsi pickers — all deferred for v1 (see
        docs/audit/HANDOVER.md). Same PageHost / Simpan-Baru-Cari-Keluar
        pattern as Registrasi and Rawat Jalan.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="12">

        <TextBlock Grid.Row="0" Text=":: [ Pasien — Identitas Pasien ] ::"
                   Foreground="{DynamicResource ThemePrimaryBrush}" FontWeight="Bold" Margin="0,0,0,8" />

        <Grid Grid.Row="1" ColumnDefinitions="3*,16,2*">

            <!-- Left: identity + PJ form -->
            <ScrollViewer Grid.Column="0">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,16,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="No. Rekam Medis :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Name="NoRmBox" IsReadOnly="True" Margin="4" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Nama Pasien :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" Name="NamaBox" Margin="4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="J.K. :" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="4" Spacing="12">
                            <RadioButton Name="JkLakiRadio" Content="Laki-laki" GroupName="jk" IsChecked="True" />
                            <RadioButton Name="JkPerempuanRadio" Content="Perempuan" GroupName="jk" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Gol. Darah :" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="4" Name="GolDarahCombo" Margin="4" HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tempat Lahir :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Name="TempatLahirBox" Margin="4" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Tgl. Lahir :" VerticalAlignment="Center" />
                        <CalendarDatePicker Grid.Row="2" Grid.Column="4" Name="TglLahirPicker" Margin="4" HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Agama :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Name="AgamaBox" Margin="4" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Stts. Nikah :" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="4" Name="StatusNikahCombo" Margin="4" HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="No. Telp :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Name="TelpBox" Margin="4" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="No. KTP :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="4" Name="KtpBox" Margin="4" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Pekerjaan :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Name="PekerjaanBox" Margin="4" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Email :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="4" Name="EmailBox" Margin="4" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Cara Bayar :" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="1" Name="PenjabCombo" Margin="4" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="6" Grid.Column="3" Text="Nama Ibu :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="6" Grid.Column="4" Name="NamaIbuBox" Margin="4" />
                    </Grid>

                    <TextBlock Text="Alamat" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,6,0,2" />
                    <TextBox Name="AlamatBox" AcceptsReturn="True" Height="44" TextWrapping="Wrap" />

                    <TextBlock Text="Penanggung Jawab (P.J.)" FontWeight="Medium" Margin="0,10,0,2"
                               Foreground="{DynamicResource ThemePrimaryBrush}" />
                    <Grid ColumnDefinitions="Auto,*,16,Auto,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Hub. P.J. :" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="0" Grid.Column="1" Name="HubunganPjCombo" Margin="4" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Nama P.J. :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" Name="NamaPjBox" Margin="4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Pekerjaan P.J. :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Name="PekerjaanPjBox" Margin="4" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Alamat P.J. :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="4" Name="AlamatPjBox" Margin="4" />
                    </Grid>

                    <TextBlock Name="SaveStatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeAccentBrush}" IsVisible="False" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="💾 Simpan" Click="OnSimpanClick" />
                        <Button Content="🆕 Baru" Click="OnBaruClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: search + patient list -->
            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
                <TextBlock Grid.Row="0" Text="Cari Pasien" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                    <TextBox Grid.Column="0" Name="KeyWordBox" PlaceholderText="Nama atau No. RM..." />
                    <Button Grid.Column="1" Content="🔎" Click="OnSearchClick" Margin="4,0,0,0" />
                </Grid>
                <DataGrid Grid.Row="2" Name="PasienGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:Pasien" SelectionChanged="OnGridSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. RM" Binding="{Binding NoRekamMedis}" Width="80" />
                        <DataGridTextColumn Header="Nama Pasien" Binding="{Binding NamaPasien}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali ke Menu" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
