<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SimrsKhanza.UI.Modules.Radiologi"
             x:Class="SimrsKhanza.UI.Modules.Radiologi.PeriksaRadiologiListView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!--
        Legacy DlgCariPeriksaRadiologi — "Data Pemeriksaan Radiologi": one header row per visit, then the
        nested "Proyeksi & Dosis Radiasi / Kode Periksa / Nama Pemeriksaan / Biaya" rows, the BHP rows and
        a grand Total, exactly how the legacy table model is built. Below the grid: the hasil bacaan editor
        (hasil_radiologi) and the permintaan's informasi/diagnosa; "Ubah" = legacy window "Ubah P.J.Rad,
        Perujuk & Petugas". Not ported: the DICOM/foto tab, hasil print models 1–3, right-click menus.
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="10">
        <TextBlock Classes="pageTitle" Grid.Row="0" Text="Data Pemeriksaan Radiologi"
                   Margin="0,0,0,6" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,170,16,Auto,Auto,Auto,Auto,16,Auto,100,16,Auto,200,16,Auto,140" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="No.Rawat :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Name="NoRawatBox" KeyUp="OnFilterKeyUp" />
            <TextBlock Grid.Column="3" Text="Tanggal :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <CalendarDatePicker Grid.Column="4" Name="FromPicker" />
            <TextBlock Grid.Column="5" Text="s.d." VerticalAlignment="Center" Margin="6,0" />
            <CalendarDatePicker Grid.Column="6" Name="ToPicker" />
            <TextBlock Grid.Column="8" Text="Pasien :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="9" Name="NoRmBox" PlaceholderText="No.RM" KeyUp="OnFilterKeyUp" />
            <TextBlock Grid.Column="11" Text="Petugas :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="12" Name="PetugasCombo" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Column="14" Text="Bacaan :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="15" Name="HasilCombo" HorizontalAlignment="Stretch" />
        </Grid>

        <DataGrid Grid.Row="2" Name="NestedGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                  HeadersVisibility="Column" CanUserResizeColumns="True"
                  x:DataType="local:RadDisplayRow" SelectionChanged="OnSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No.Rawat" Binding="{Binding C0}" Width="1.1*" MinWidth="110" />
                <DataGridTextColumn Header="Pasien" Binding="{Binding C1}" Width="2.2*" MinWidth="200" />
                <DataGridTextColumn Header="Petugas" Binding="{Binding C2}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="Tgl.Periksa" Binding="{Binding C3}" Width="1.1*" MinWidth="90" />
                <DataGridTextColumn Header="Jam Periksa" Binding="{Binding C4}" Width="0.7*" MinWidth="70" />
                <DataGridTextColumn Header="Dokter Perujuk" Binding="{Binding C5}" Width="1.5*" MinWidth="120" />
                <DataGridTextColumn Header="Penanggung Jawab" Binding="{Binding C6}" Width="1.5*" MinWidth="120" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}" Padding="8" CornerRadius="4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,2*,16,Auto,*,16,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hasil Pemeriksaan :" VerticalAlignment="Top" Margin="0,4,4,0" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Name="HasilBox" AcceptsReturn="True" TextWrapping="Wrap" Height="64" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Informasi Tambahan :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Grid.Row="0" Grid.Column="4" Name="InformasiBox" IsReadOnly="True" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Diagnosis Klinis :" VerticalAlignment="Center" Margin="0,4,4,0" />
                <TextBox Grid.Row="1" Grid.Column="4" Name="DiagnosisBox" IsReadOnly="True" Margin="0,4,0,0" />
                <StackPanel Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" Spacing="4">
                    <Button Content="💾 Update Hasil" Click="OnUpdateHasilClick" />
                    <Button Content="✏ Ubah P.J./Perujuk/Petugas" Click="OnUbahClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Name="UbahPanel" IsVisible="False" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ThemeSurfaceBrush}" Padding="8" CornerRadius="4" Margin="0,6,0,0">
            <Grid ColumnDefinitions="Auto,*,16,Auto,*,16,Auto,*,16,Auto,Auto">
                <TextBlock Grid.Column="0" Text="P.J. Rad :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="1" Name="UbahPjCombo" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="3" Text="Perujuk :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="4" Name="UbahPerujukCombo" HorizontalAlignment="Stretch" />
                <TextBlock Grid.Column="6" Text="Petugas :" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox Grid.Column="7" Name="UbahPetugasCombo" HorizontalAlignment="Stretch" />
                <Button Grid.Column="9" Content="💾 Simpan" Click="OnUbahSimpanClick" />
                <Button Grid.Column="10" Content="Tutup" Click="OnUbahTutupClick" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <Grid Grid.Row="5" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Key Word :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Grid.Column="1" Name="KeywordBox" KeyUp="OnFilterKeyUp" MaxWidth="300" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="2" Name="RecordText" Text="Record : 0" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock Grid.Column="3" Name="TotalText" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Medium" />
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Content="🔍 Cari" Click="OnCariClick" />
            <Button Content="🩻 Periksa Baru" Click="OnInputClick" />
            <Button Content="🗑 Hapus" Click="OnHapusClick" />
            <Button Content="📋 Semua" Click="OnSemuaClick" />
            <Button Content="🖨 Cetak" Click="OnCetakClick" />
            <Button Content="❌ Keluar" Click="OnBackClick" Classes="accentText" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
