<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SimrsKhanza.UI.Modules.Informasi.MenuAInformasiView" Background="{DynamicResource ThemeBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
    <TextBlock Name="Judul" FontWeight="Bold" Foreground="{DynamicResource ThemePrimaryBrush}" />
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="Kata kunci:" VerticalAlignment="Center"/><TextBox Name="KataKunci" Width="220"/><Button Content="🔎 Cari" Click="OnCari"/><TextBlock Name="Status" VerticalAlignment="Center"/></StackPanel>
    <WrapPanel Grid.Row="2" Name="FormJadwal" Orientation="Horizontal" IsVisible="False">
      <TextBlock Text="Dokter:" VerticalAlignment="Center"/><ComboBox Name="Dokter" Width="190" Margin="5,0,10,0"/>
      <TextBlock Text="Poli:" VerticalAlignment="Center"/><ComboBox Name="Poli" Width="160" Margin="5,0,10,0"/>
      <TextBlock Text="Hari:" VerticalAlignment="Center"/><ComboBox Name="Hari" Width="100" Margin="5,0,10,0"><ComboBoxItem Content="SENIN"/><ComboBoxItem Content="SELASA"/><ComboBoxItem Content="RABU"/><ComboBoxItem Content="KAMIS"/><ComboBoxItem Content="JUMAT"/><ComboBoxItem Content="SABTU"/><ComboBoxItem Content="AKHAD"/></ComboBox>
      <TextBlock Text="Jam mulai:" VerticalAlignment="Center"/><TextBox Name="Mulai" Width="70" Text="08:00" Margin="5,0,10,0"/>
      <TextBlock Text="Selesai:" VerticalAlignment="Center"/><TextBox Name="Selesai" Width="70" Text="12:00" Margin="5,0,10,0"/>
      <TextBlock Text="Kuota:" VerticalAlignment="Center"/><TextBox Name="Kuota" Width="55" Margin="5,0,10,0"/><Button Content="💾 Simpan" Click="OnSimpan"/>
    </WrapPanel>
    <DataGrid Grid.Row="3" Name="Tabel" AutoGenerateColumns="True" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column" />
    <Button Grid.Row="4" Content="⬅ Kembali ke Menu" Click="OnBack" HorizontalAlignment="Left" />
  </Grid>
</UserControl>
