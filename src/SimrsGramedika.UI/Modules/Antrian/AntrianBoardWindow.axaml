<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:SimrsGramedika.Data"
        x:Class="SimrsGramedika.UI.Modules.Antrian.AntrianBoardWindow"
        Title="Antrian" Width="1100" Height="720"
        Icon="avares://SimrsGramedika.UI/Assets/SIMRS Gramedika Hospital System Icon.png"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFF7E6"
        KeyDown="OnKeyDown">

    <!--
        Native counterpart of the legacy webapps/ display pages (poli.php, antrian.php,
        antrianradiologi.php, antrianlaborat*.php, antrianfarmasi*.php): institution
        header + clock, "Panggilan ..." panel, today's table, auto-refresh, bell sound.
        A normal window on purpose — legacy opens it in a browser that gets dragged to the
        second monitor; F11 toggles fullscreen, Esc leaves it.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Border Grid.Row="0" Background="#FF1E3A8A" Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Grid.Column="0" Source="avares://SimrsGramedika.UI/Assets/SIMRS Gramedika Hospital System Icon.png" Width="72" Height="72" Margin="0,0,16,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="InstansiText" FontSize="34" FontWeight="Bold" Foreground="White" />
                    <TextBlock Name="AlamatText" FontSize="16" Foreground="#FFC7D2FE" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Name="ClockText" FontSize="28" FontWeight="SemiBold" Foreground="#FFFDE68A" HorizontalAlignment="Right" />
                    <TextBlock Name="DateText" FontSize="14" Foreground="#FFC7D2FE" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#FFF3F4F6" Padding="16,8">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Name="TitleText" FontSize="24" FontWeight="Bold" Foreground="#FF1E3A8A" />
                    <TextBlock Name="SubtitleText" FontSize="13" Foreground="#FF6B7280" />
                </StackPanel>
                <Button Grid.Column="1" Content="⛶ Layar Penuh (F11)" Click="OnFullscreenClick" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Name="CallPanel" Background="#FFFF3D00" Padding="16,10" IsVisible="False">
            <ItemsControl Name="CallItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="data:AntrianCall">
                        <Grid ColumnDefinitions="360,24,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="24" Foreground="White" />
                            <TextBlock Grid.Column="1" Text=":" FontSize="24" Foreground="White" />
                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="26" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <DataGrid Grid.Row="3" Name="BoardGrid" Margin="16,10" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="All" HeadersVisibility="Column" FontSize="20" RowHeight="40"
                  CanUserResizeColumns="True" DoubleTapped="OnGridDoubleTapped" />

        <Border Grid.Row="4" Name="BannerPanel" IsVisible="False" Background="#FFFFE6A1" Padding="16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Image Name="BannerImage" IsVisible="False" MaxHeight="54" MaxWidth="180" Stretch="Uniform" />
                <TextBlock Grid.Column="1" Name="BannerText" TextWrapping="Wrap" MaxLines="3"
                           VerticalAlignment="Center" FontSize="18" Foreground="#FF172554" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#FF1E3A8A" Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusText" FontSize="13" Foreground="#FFC7D2FE" />
                <TextBlock Grid.Column="1" Name="RecordText" FontSize="13" Foreground="#FFC7D2FE" />
            </Grid>
        </Border>
    </Grid>
</Window>
