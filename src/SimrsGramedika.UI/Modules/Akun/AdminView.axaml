<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsGramedika.UI.Modules.Akun.AdminView"
             Background="{DynamicResource TegasPageBrush}">

    <!-- Port of legacy setting/DlgAdmin.java (`admin` table, AES 'nur'/'windi'). -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12" RowSpacing="6">
        <Border Grid.Row="0" Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Text="Admin Utama" />
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="6">
            <Border Background="{DynamicResource ThemePanelBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
          <DockPanel>
            <ToggleButton Name="InputDataToggle" DockPanel.Dock="Bottom" Classes="inputData" IsChecked="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          AutomationProperties.Name="Input Data" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Width="12" Height="8" Stretch="Uniform" StrokeThickness="1.7"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          Stroke="{DynamicResource ThemeIconBrush}" Data="M2,2 L7,7 L12,2" />
                    <TextBlock Text="Input Data" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Border Name="InputDataPanel" Padding="10,7"
                    IsVisible="{ReflectionBinding #InputDataToggle.IsChecked, FallbackValue=False, TargetNullValue=False}">
            <ScrollViewer MaxHeight="340">
            <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="Tambah admin / reset password" FontWeight="Medium" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           Text="Admin Utama punya SEMUA hak akses, di aplikasi ini maupun di SIMRS Khanza lama. Pilih admin di daftar untuk mereset password-nya." />
                <TextBox Name="UsereBox" PlaceholderText="ID admin" />
                <TextBox Name="PassBox" PlaceholderText="Password" PasswordChar="*" />
                <TextBox Name="Pass2Box" PlaceholderText="Ulangi password" PasswordChar="*" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Tambah Admin" Click="OnTambahClick" />
                    <Button Content="Reset Password" Click="OnResetClick" />
                </StackPanel>
                <TextBlock Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
            </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>
            <Grid Grid.Row="1" RowSpacing="6" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" Name="AdminList" />
                <Button Grid.Row="1" Content="Hapus Admin Terpilih" Click="OnHapusClick" />
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="servicePanel">
            <Button Content="Kembali" Click="OnBackClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
