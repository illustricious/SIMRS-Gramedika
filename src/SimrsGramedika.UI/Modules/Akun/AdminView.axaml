<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsGramedika.UI.Modules.Akun.AdminView"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <!-- Port of legacy setting/DlgAdmin.java (`admin` table, AES 'nur'/'windi'). -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <TextBlock Classes="pageTitle" Grid.Row="0" Text="Admin Utama"
                   Margin="0,0,0,12" />

        <Grid Grid.Row="1" ColumnDefinitions="300,16,*">
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <ListBox Grid.Row="0" Name="AdminList" />
                <Button Grid.Row="1" Content="🗑 Hapus Admin Terpilih" Click="OnHapusClick" Margin="0,8,0,0" />
            </Grid>

            <StackPanel Grid.Column="2" Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                <TextBlock Text="Tambah admin / reset password" FontWeight="Medium" />
                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondaryBrush}"
                           Text="Admin Utama punya SEMUA hak akses, di aplikasi ini maupun di SIMRS Khanza lama. Pilih admin di kiri untuk mereset password-nya." />
                <TextBox Name="UsereBox" PlaceholderText="ID admin" />
                <TextBox Name="PassBox" PlaceholderText="Password" PasswordChar="*" />
                <TextBox Name="Pass2Box" PlaceholderText="Ulangi password" PasswordChar="*" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="➕ Tambah Admin" Click="OnTambahClick" />
                    <Button Content="🔑 Reset Password" Click="OnResetClick" />
                </StackPanel>
                <TextBlock Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
