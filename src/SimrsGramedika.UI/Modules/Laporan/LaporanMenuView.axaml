<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsGramedika.UI.Modules.Laporan.LaporanMenuView"
             Background="{DynamicResource TegasPageBrush}">

    <!-- Same submenu-tile pattern as LabMenuView/FarmasiMenuView. v1 scope:
         3 reports built from data this app already writes (Registrasi, Kasir,
         Farmasi) — not a port of every legacy laporan.* screen. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12" RowSpacing="6">
        <Border Grid.Row="0" Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Text="Laporan" />
        </Border>

        <Grid Grid.Row="1" Name="TilePanel" ColumnSpacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Top" />

        <Border Grid.Row="2" Classes="servicePanel">
            <Button Content="Kembali ke Menu" Click="OnBackClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.labTile">
            <Setter Property="Height" Value="180" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
