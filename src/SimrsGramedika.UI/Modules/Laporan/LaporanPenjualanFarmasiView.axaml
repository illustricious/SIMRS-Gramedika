<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsGramedika.Data"
             x:Class="SimrsGramedika.UI.Modules.Laporan.LaporanPenjualanFarmasiView"
             Background="{DynamicResource TegasPageBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12" RowSpacing="6">
        <Border Grid.Row="0" Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Text="Laporan Penjualan Farmasi" />
        </Border>

        

        <DataGrid Grid.Row="2" Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                  x:DataType="data:PenjualanListItem">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Transaksi" Binding="{Binding NoKeluar}" Width="150" />
                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
                <DataGridTextColumn Header="Barang" Binding="{Binding NamaBarang}" Width="*" />
                <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100" />
                <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Classes="servicePanel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4">
            <TextBlock Text="Periode :" VerticalAlignment="Center" />
            <CalendarDatePicker Name="FromPicker" />
            <TextBlock Text="s.d." VerticalAlignment="Center" />
            <CalendarDatePicker Name="ToPicker" />
            <Button Content="Tampilkan" Click="OnTampilkanClick" />
            <TextBlock Name="RingkasanText" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource ThemeTextSecondaryBrush}" />
        </WrapPanel>
                <Button Grid.Column="1" Content="Kembali" Click="OnBackClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
