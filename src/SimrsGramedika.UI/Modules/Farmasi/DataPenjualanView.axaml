<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsGramedika.Data"
             x:Class="SimrsGramedika.UI.Modules.Farmasi.DataPenjualanView"
             Background="{DynamicResource TegasPageBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12">
        <Border Grid.Row="0" Classes="tegasHeading" Margin="0,0,0,6">
            <TextBlock Classes="pageTitle" Text="Data Penjualan Obat &amp; BHP" />
        </Border>

        

        <DataGrid Grid.Row="2" Name="PenjualanGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                  x:DataType="data:PenjualanListItem">
            <DataGrid.Columns>
                <DataGridTextColumn Header="No. Transaksi" Binding="{Binding NoKeluar}" Width="150" />
                <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="100" />
                <DataGridTextColumn Header="Barang" Binding="{Binding NamaBarang}" Width="*" />
                <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80" />
                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="100" />
                <DataGridTextColumn Header="Keterangan" Binding="{Binding Keterangan}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Classes="servicePanel" Margin="0,6,0,0">
            <StackPanel Spacing="4">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <TextBlock Text="Periode:" VerticalAlignment="Center" />
                <CalendarDatePicker Name="FromPicker" />
                <TextBlock Text="s.d." VerticalAlignment="Center" />
                <CalendarDatePicker Name="ToPicker" />
                <TextBlock Text="Kata kunci:" VerticalAlignment="Center" />
                <TextBox Name="KeywordBox" Width="210" PlaceholderText="Nota, barang, keterangan" KeyDown="OnKeywordKeyDown" />
                <Button Content="Tampilkan" Click="OnTampilkanClick" Classes="accent" />
            </WrapPanel>
        
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <Button Content="Kembali" Click="OnBackClick" />
                <TextBlock Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
        
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.success">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
