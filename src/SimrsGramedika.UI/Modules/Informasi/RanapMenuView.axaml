<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SimrsGramedika.UI.Modules.Informasi.RanapMenuView" Background="{DynamicResource TegasPageBrush}">
 <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16,12" RowSpacing="6">
  <Border Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Name="Judul"/>
        </Border>
  
  <WrapPanel Grid.Row="2" Name="FormDpjp" IsVisible="False"><TextBlock Text="No. Rawat:" VerticalAlignment="Center"/><TextBox Name="Rawat" Width="160" Margin="6,0,12,0"/><TextBlock Text="Dokter:" VerticalAlignment="Center"/><ComboBox Name="Dokter" Width="220" Margin="6,0,8,0"/><Button Content="Tambah" Click="OnTambah" Margin="0,0,6,0"/><Button Content="Ubah pilihan" Click="OnUbah" Margin="0,0,6,0"/><Button Content="Hapus pilihan" Click="OnHapus"/><Border Name="Konfirmasi" IsVisible="False" Margin="10,0"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Hapus DPJP terpilih?" VerticalAlignment="Center"/><Button Content="Ya, hapus" Click="OnHapusYa"/><Button Content="Batal" Click="OnBatal"/></StackPanel></Border></WrapPanel>
  <DataGrid Grid.Row="3" Name="Tabel" AutoGenerateColumns="True" IsReadOnly="True" CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column" SelectionChanged="OnPilih"/>
  <Border Grid.Row="4" Classes="servicePanel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <WrapPanel><TextBlock Text="Periode:" VerticalAlignment="Center" Margin="0,0,5,0"/><CalendarDatePicker Name="Dari"/><TextBlock Text="s.d." VerticalAlignment="Center" Margin="8,0"/><CalendarDatePicker Name="Sampai"/><TextBlock Text="Kata kunci:" VerticalAlignment="Center" Margin="12,0,5,0"/><TextBox Name="Cari" Width="180"/><ComboBox Name="Jenis" Width="160" Margin="8,0" IsVisible="False" SelectedIndex="0"><ComboBoxItem Content="Dokter"/><ComboBoxItem Content="Petugas"/><ComboBoxItem Content="Dokter dan Petugas"/></ComboBox><Button Content="Cari" Click="OnCari" Margin="8,0"/><TextBlock Name="Status" VerticalAlignment="Center"/></WrapPanel>
                <Button Grid.Column="1" Content="Kembali ke Menu" Click="OnBack" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            </Grid>
        </Border>
 </Grid>
</UserControl>
