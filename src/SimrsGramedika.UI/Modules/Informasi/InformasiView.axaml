<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsGramedika.Data"
             x:Class="SimrsGramedika.UI.Modules.Informasi.InformasiView"
             Background="{DynamicResource TegasPageBrush}">

    <!--
        Read-only lookups. Embedded in MainWindow's PageHost like every other
        module — same single-window navigation, same design language — NOT a
        separate OS Window. (An earlier revision made this a standalone Window
        so it could be dragged to a second monitor, mirroring the legacy app;
        reverted per user feedback: keep it consistent with the rest instead.)

        v1 scope: of the legacy submenu (Pasien Kamar Inap, Telusur Kunjungan
        Pasien, Penggunaan Kamar Inap, Ketersediaan Stok Darah UTD, Tarif
        per-modul, Dashboard, Koleksi Penelitian, Cari Koleksi Ebook, Cari
        Inventaris Perpustakaan), only the 4 backed by data this app already
        models are implemented. See docs/handover/04-HISTORY.md.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12">
        <Border Classes="tegasHeading" Margin="0,0,0,6">
            <TextBlock Classes="pageTitle" Text="Informasi" />
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Pasien Kamar Inap">
                <DataGrid Name="KamarInapGrid" Margin="0,8" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:PasienKamarInapItem">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Rawat" Binding="{Binding NoRawat}" Width="150" />
                        <DataGridTextColumn Header="Nama Pasien" Binding="{Binding NamaPasien}" Width="*" />
                        <DataGridTextColumn Header="Kamar" Binding="{Binding KodeKamar}" Width="90" />
                        <DataGridTextColumn Header="Bangsal" Binding="{Binding NamaBangsal}" Width="130" />
                        <DataGridTextColumn Header="Tgl Masuk" Binding="{Binding TanggalMasuk}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Telusur Kunjungan Pasien">
                <Grid RowDefinitions="Auto,*" Margin="0,8">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="Cari (No.RM / No.Rawat / Nama) :" VerticalAlignment="Center" />
                        <TextBox Name="TelusurKeywordBox" Width="260" />
                        <Button Content="🔍 Cari" Click="OnTelusurCariClick" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" Name="TelusurGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                              x:DataType="data:TelusurKunjunganItem">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No. Rawat" Binding="{Binding NoRawat}" Width="150" />
                            <DataGridTextColumn Header="No.RM" Binding="{Binding NoRekamMedis}" Width="90" />
                            <DataGridTextColumn Header="Nama Pasien" Binding="{Binding NamaPasien}" Width="*" />
                            <DataGridTextColumn Header="Poli" Binding="{Binding NamaPoli}" Width="110" />
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding TanggalRegistrasi}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Penggunaan Kamar Inap">
                <DataGrid Name="PenggunaanKamarGrid" Margin="0,8" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:PenggunaanKamarItem">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kamar" Binding="{Binding KodeKamar}" Width="100" />
                        <DataGridTextColumn Header="Bangsal" Binding="{Binding NamaBangsal}" Width="150" />
                        <DataGridTextColumn Header="Kelas" Binding="{Binding Kelas}" Width="120" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Ketersediaan Stok Darah UTD">
                <DataGrid Name="StokDarahGrid" Margin="0,8" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserResizeColumns="True" GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:StokDarahItem">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Golongan Darah" Binding="{Binding GolonganDarah}" Width="130" />
                        <DataGridTextColumn Header="Resus" Binding="{Binding Resus}" Width="100" />
                        <DataGridTextColumn Header="Jumlah Kantong" Binding="{Binding JumlahKantong}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="⬅ Kembali ke Menu" Click="OnBackClick" Classes="accentText" />
        </StackPanel>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
