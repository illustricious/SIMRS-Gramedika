<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimrsGramedika.UI.Modules.Radiologi.PermintaanRadiologiListView"
             Background="{DynamicResource TegasPageBrush}">

    <!--
        Legacy DlgCariPermintaanRadiologi: "Data Permintaan Radiologi" — Rawat Jalan / Rawat Inap
        tabs, each with "Data Permintaan" (a permintaan row followed by one row per ordered
        examination) and "Item Permintaan" (one row per examination). Grids are built in code.
        The RIS bridging buttons (FUJI, Care Stream) and barcode/lembar printing are not ported.
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="16,12">
        <Border Grid.Row="0" Classes="tegasHeading" Margin="0,0,0,6">
            <TextBlock Classes="pageTitle" Text="Data Permintaan Radiologi" />
        </Border>

        <Border Grid.Row="1" Classes="servicePanel" Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Tanggal :" VerticalAlignment="Center" />
                    <CalendarDatePicker Name="FromPicker" />
                    <TextBlock Text="s.d." VerticalAlignment="Center" />
                    <CalendarDatePicker Name="ToPicker" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Dokter :" VerticalAlignment="Center" />
                    <TextBox Name="DokterBox" Width="150" KeyUp="OnFilterKeyUp" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Name="LokasiLabel" Text="Unit/Poli :" VerticalAlignment="Center" />
                    <TextBox Name="LokasiBox" Width="150" KeyUp="OnFilterKeyUp" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Name="StatusLabel" Text="Status :" VerticalAlignment="Center" IsVisible="False" />
                    <ComboBox Name="StatusCombo" Width="120" IsVisible="False" SelectedIndex="0">
                        <ComboBoxItem Content="Semua" />
                        <ComboBoxItem Content="Belum Pulang" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Kata kunci" VerticalAlignment="Center" />
                    <TextBox Name="KeywordBox" Width="200" KeyUp="OnFilterKeyUp" />
                </StackPanel>
                <Button Content="🔍 Cari" Click="OnCariClick" Classes="accent" Margin="0,0,0,4" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Name="ConfirmPanel" IsVisible="False" BorderBrush="{DynamicResource ThemeBorderBrush}"
                BorderThickness="1" Background="{DynamicResource ThemeSurfaceBrush}" Padding="10" CornerRadius="4" Margin="0,0,0,6">
            <StackPanel Spacing="6">
                <TextBlock Name="ConfirmText" TextWrapping="Wrap" FontWeight="Medium" />
                <StackPanel Name="SampelFields" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <TextBlock Text="Tanggal &amp; Jam :" VerticalAlignment="Center" />
                    <CalendarDatePicker Name="SampelDatePicker" />
                    <TextBox Name="SampelTimeBox" Width="90" PlaceholderText="HH:mm:ss" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="ConfirmYesButton" Content="Ya" Click="OnConfirmYesClick" />
                    <Button Content="Batal" Click="OnConfirmCancelClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="3" Name="LokasiTabs" SelectionChanged="OnLokasiTabChanged">
            <TabItem Header="Rawat Jalan">
                <TabControl Name="RalanSubTabs">
                    <TabItem Header="Data Permintaan">
                        <DataGrid Name="RalanDataGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                                  HeadersVisibility="Column" CanUserResizeColumns="True" />
                    </TabItem>
                    <TabItem Header="Item Permintaan">
                        <DataGrid Name="RalanItemGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                                  HeadersVisibility="Column" CanUserResizeColumns="True" />
                    </TabItem>
                </TabControl>
            </TabItem>
            <TabItem Header="Rawat Inap">
                <TabControl Name="RanapSubTabs">
                    <TabItem Header="Data Permintaan">
                        <DataGrid Name="RanapDataGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                                  HeadersVisibility="Column" CanUserResizeColumns="True" />
                    </TabItem>
                    <TabItem Header="Item Permintaan">
                        <DataGrid Name="RanapItemGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All"
                                  HeadersVisibility="Column" CanUserResizeColumns="True" />
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Classes="servicePanel" Margin="0,6,0,0">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                <Button Content="🗑 Hapus" Click="OnHapusClick" />
                <Button Content="🧪 Sampel" Click="OnSampelClick" />
                <Button Content="📄 Hasil" Click="OnHasilClick" />
                <Button Content="📋 Semua" Click="OnSemuaClick" />
                <Button Content="🖨 Cetak" Click="OnCetakClick" />
                <TextBlock Name="RecordText" Text="Record : 0" VerticalAlignment="Center" Margin="12,0,0,0" />
                <Button Content="❌ Keluar" Click="OnBackClick" Classes="accentText" Margin="12,0,0,0" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="5" Name="StatusText" Margin="0,6,0,0" TextWrapping="Wrap" IsVisible="False" />
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
