<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsGramedika.Data"
             xmlns:local="using:SimrsGramedika.UI.Modules.RawatJalan"
             x:Class="SimrsGramedika.UI.Modules.RawatJalan.RawatJalanView"
             Background="{DynamicResource TegasPageBrush}">

    <!--
        Rawat Jalan: kiri daftar kunjungan rawat jalan (status_lanjut Ralan, bukan IGD) per rentang tanggal,
        kanan daftar pemeriksaan (SOAP) kunjungan terpilih dan form tambah/ubah/hapus. Aturan akses mengikuti
        DlgRawatJalan (RawatJalanService): non-Admin Utama hanya data miliknya, ubah/hapus 48 jam.
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,12" RowSpacing="6">

        <Border Name="PageHeading" Grid.Row="0" Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Text="Rawat Jalan - Pemeriksaan Dokter" />
        </Border>

        

        <Grid Name="WorkArea" Grid.Row="1" RowDefinitions="3*,2*" RowSpacing="6">
            <Border Background="{DynamicResource ThemePanelBrush}" Name="InputBorder"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="6">
          <DockPanel>
            <ToggleButton Name="InputDataToggle" DockPanel.Dock="Bottom" Classes="inputData" IsChecked="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          AutomationProperties.Name="Input Data" Padding="12,4">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Path Width="12" Height="8" Stretch="Uniform" StrokeThickness="1.7"
                          StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                          Stroke="{DynamicResource ThemeIconBrush}" Data="M2,2 L7,7 L12,2" />
                    <TextBlock Text="Input Data" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
            <Border Name="InputDataPanel" Padding="10,7"
                    IsVisible="{ReflectionBinding #InputDataToggle.IsChecked, FallbackValue=False, TargetNullValue=False}">
<ScrollViewer Name="InputScroll" Padding="0,0,24,0">
                <StackPanel Spacing="6">
                    <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="10">
                        <TextBlock Name="SelectedPatientText" Text="(belum ada kunjungan dipilih)"
                                   FontWeight="Medium" Foreground="{DynamicResource ThemeTextBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Pemeriksaan tersimpan (pilih baris untuk mengubah)" FontWeight="Medium" Margin="0,4,0,0"
                               Foreground="{DynamicResource ThemeTextBrush}" />
                    <DataGrid Name="SoapGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="140"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              x:DataType="local:SoapItem" SelectionChanged="OnSoapSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal}" Width="90" />
                            <DataGridTextColumn Header="Jam" Binding="{Binding Jam}" Width="70" />
                            <DataGridTextColumn Header="Tensi" Binding="{Binding Tensi}" Width="64" />
                            <DataGridTextColumn Header="Penilaian" Binding="{Binding Penilaian}" Width="*" />
                            <DataGridTextColumn Header="Pemeriksa" Binding="{Binding Pemeriksa}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <TextBlock Text="Tanggal" VerticalAlignment="Center" />
                        <CalendarDatePicker Grid.Column="1" Name="TanggalPicker" AutomationProperties.Name="Tanggal pemeriksaan" />
                        <TextBlock Grid.Column="2" Text="Jam" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Name="JamBox" Width="86" AutomationProperties.Name="Jam pemeriksaan" />
                        <TextBlock Grid.Column="4" Text="Dokter/Paramedis" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="5" Name="PegawaiCombo" HorizontalAlignment="Stretch" AutomationProperties.Name="Dokter atau paramedis" />
                    </Grid>

                    <TextBlock Text="Tanda Vital" FontWeight="Medium" Margin="0,8,0,0" Foreground="{DynamicResource ThemeTextBrush}" />
                    <Grid ColumnDefinitions="Auto,*,16,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tensi :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Name="TensiBox" PlaceholderText="120/80" Margin="4" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Nadi :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="4" Name="NadiBox" PlaceholderText="x/mnt" Margin="4" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Suhu :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Name="SuhuBox" PlaceholderText="°C" Margin="4" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Respirasi :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="4" Name="RespirasiBox" PlaceholderText="x/mnt" Margin="4" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tinggi :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Name="TinggiBox" PlaceholderText="cm" Margin="4" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Berat :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="4" Name="BeratBox" PlaceholderText="kg" Margin="4" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="SpO2 :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Name="Spo2Box" PlaceholderText="%" Margin="4" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="GCS :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="4" Name="GcsBox" PlaceholderText="E4V5M6" Margin="4" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Alergi :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Name="AlergiBox" Margin="4" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Lingkar Perut :" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="4" Name="LingkarPerutBox" PlaceholderText="cm" Margin="4" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="Kesadaran :" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" Name="KesadaranCombo" Margin="4" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Text="Keluhan" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,8,0,2" />
                    <TextBox Name="KeluhanBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

                    <TextBlock Text="Pemeriksaan" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,2" />
                    <TextBox Name="PemeriksaanBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

                    <TextBlock Text="Penilaian / Diagnosa" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,2" />
                    <TextBox Name="PenilaianBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

                    <TextBlock Text="RTL (Rencana Tindak Lanjut)" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,2" />
                    <TextBox Name="RtlBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />

                    <TextBlock Text="Instruksi" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,2" />
                    <TextBox Name="InstruksiBox" AcceptsReturn="True" Height="40" TextWrapping="Wrap" />

                    <TextBlock Text="Evaluasi" Foreground="{DynamicResource ThemeTextBrush}" Margin="0,4,0,2" />
                    <TextBox Name="EvaluasiBox" AcceptsReturn="True" Height="40" TextWrapping="Wrap" />

                    

                    
                </StackPanel>
            </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>
            <Grid Name="QueueArea" Grid.Row="1" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Name="QueueCountText" Text="Kunjungan Rawat Jalan" FontWeight="Medium" Margin="0,0,0,4"
                           Foreground="{DynamicResource ThemeTextBrush}" />
                <DataGrid Grid.Row="1" Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="All" HeadersVisibility="Column"
                          x:DataType="data:RawatJalanKunjungan"
                          SelectionChanged="OnQueueSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat=\{0:yyyy-MM-dd\}}" Width="90" />
                        <DataGridTextColumn Header="No. Rawat" Binding="{Binding NoRawat}" Width="140" />
                        <DataGridTextColumn Header="Pasien" Binding="{Binding Pasien}" Width="*" />
                        <DataGridTextColumn Header="Poli" Binding="{Binding Poli}" Width="100" />
                        <DataGridTextColumn Header="Dokter" Binding="{Binding Dokter}" Width="120" />
                        <DataGridTextColumn Header="SOAP" Binding="{Binding JumlahPemeriksaan}" Width="52" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Classes="servicePanel">
            <StackPanel Spacing="4">
                <Grid Name="QueueFilters" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="Periode" VerticalAlignment="Center" />
            <CalendarDatePicker Grid.Column="1" Name="DariPicker" AutomationProperties.Name="Dari tanggal" />
            <TextBlock Grid.Column="2" Text="s.d." VerticalAlignment="Center" />
            <CalendarDatePicker Grid.Column="3" Name="SampaiPicker" AutomationProperties.Name="Sampai tanggal" />
            <TextBlock Grid.Column="4" Text="Kata kunci" VerticalAlignment="Center" />
            <TextBox Grid.Column="5" Name="CariBox" PlaceholderText="No. rawat, no. RM, pasien, poli, atau dokter"
                     AutomationProperties.Name="Cari kunjungan" KeyDown="OnCariKeyDown" />
            <Button Grid.Column="6" Content="Cari" Classes="accent" Click="OnCariClick" />
            <Button Grid.Column="7" Content="Semua" Click="OnSemuaClick" />
        </Grid>
                <TextBlock Name="SaveStatusText" TextWrapping="Wrap"
                               Foreground="{DynamicResource ThemeAccentBrush}" IsVisible="False" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                        <Button Content="Baru" Click="OnBaruClick" />
                        <Button Content="5 SOAPIE Ralan" Click="OnLimaTerakhirClick" />
                        <Button Content="5 SOAPIE Ranap" Tag="Ranap" Click="OnLimaTerakhirClick" />
                        <Button Name="TemplateButton" Content="Template SOAPIE" Click="OnTemplateClick" IsEnabled="False" />
                        <Button Name="AlurKunjunganButton" Content="Alur Kunjungan" IsVisible="False" Click="OnAlurKunjunganClick" />
                        <Button Name="SimpanButton" Content="Simpan" Classes="accent" Click="OnSimpanClick" IsEnabled="False" />
                        <Button Name="UbahButton" Content="Ganti" Click="OnUbahClick" IsEnabled="False" />
                        <Button Name="HapusButton" Content="Hapus" Click="OnHapusClick" IsEnabled="False" />
                        <Button Name="CetakSoapButton" Content="Simpan PDF" Click="OnCetakSoapClick" IsEnabled="False" />
                    </WrapPanel>
                    <Button Name="PageFooter" Grid.Column="1" Content="Kembali ke Menu" Click="OnBackClick" VerticalAlignment="Bottom" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
