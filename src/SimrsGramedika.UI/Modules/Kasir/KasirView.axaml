<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:data="using:SimrsGramedika.Data"
             x:Class="SimrsGramedika.UI.Modules.Kasir.KasirView"
             Background="{DynamicResource TegasPageBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,12" RowSpacing="6">

        <Border Grid.Row="0" Classes="tegasHeading">
            <TextBlock Classes="pageTitle" Text="Kasir — Tagihan Pasien" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="No. Rawat :" VerticalAlignment="Center" />
            <TextBox Name="NoRawatBox" Width="260" PlaceholderText="contoh: 2026/11/07/000001" KeyDown="OnNoRawatKeyDown" />
            <Button Name="CariButton" Content="Cari Tagihan" Click="OnCariClick" />
            <Button Name="PiutangButton" Content="Piutang Pasien" Click="OnPiutangClick" IsVisible="False" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
          <Border Background="{DynamicResource ThemeSurfaceBrush}" CornerRadius="4" Padding="14" VerticalAlignment="Top">
            <StackPanel Spacing="8">
            <TextBlock Name="NotFoundText" Foreground="{DynamicResource ThemeAccentBrush}" TextWrapping="Wrap" IsVisible="False" />
            <StackPanel Spacing="6" Name="BillPanel" IsVisible="False">
                <TextBlock Name="PatientText" Classes="sectionTitle" />
                <DataGrid Name="RincianGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="360" GridLinesVisibility="All" HeadersVisibility="Column" x:DataType="data:KasirRincian">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="175"/>
                        <DataGridTextColumn Header="Rincian" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Tarif (Rp)" Binding="{Binding Tarif, StringFormat='#,0.####'}" Width="125"/>
                        <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah, StringFormat=0.####}" Width="80"/>
                        <DataGridTextColumn Header="Total (Rp)" Binding="{Binding Total, StringFormat='#,0.####'}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Name="PenyesuaianRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <Button Name="TambahanButton" Content="Tambahan Biaya" Click="OnTambahanClick" />
                    <Button Name="PotonganButton" Content="Potongan Biaya" Click="OnPotonganClick" />
                </StackPanel>
                <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Total Tagihan" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Name="TotalText" FontWeight="Bold" />
                    <TextBlock Grid.Row="1" Text="Status Bayar" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Name="StatusBayarText" />
                    <TextBlock Grid.Row="2" Name="DepositLabel" Text="Deposit" IsVisible="False" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Name="DepositText" TextWrapping="Wrap" IsVisible="False" />
                </Grid>
                <StackPanel Name="AkunBayarRow" Orientation="Horizontal" Spacing="8" IsVisible="False">
                    <TextBlock Text="Akun Bayar" VerticalAlignment="Center" />
                    <ComboBox Name="AkunBayarBox" MinWidth="240" PlaceholderText="Pilih akun bayar" />
                </StackPanel>
                <StackPanel Name="PiutangRow" Spacing="6" IsVisible="False">
                    <CheckBox Name="PiutangCheck" Content="Simpan sisa tagihan sebagai piutang" IsCheckedChanged="OnPiutangCheck" />
                    <StackPanel Name="PiutangIsian" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="Uang muka" VerticalAlignment="Center" />
                        <TextBox Name="UangMukaBox" Width="150" PlaceholderText="0" />
                        <TextBlock Text="Akun piutang" VerticalAlignment="Center" />
                        <ComboBox Name="AkunPiutangBox" MinWidth="220" PlaceholderText="Pilih akun piutang" />
                        <TextBlock Text="Jatuh tempo" VerticalAlignment="Center" />
                        <CalendarDatePicker Name="TempoPicker" />
                    </StackPanel>
                </StackPanel>
                <Button Name="BayarButton" Content="Catat Pelunasan" Click="OnBayarClick"
                        HorizontalAlignment="Left" Margin="0,8,0,0" />
                <Button Name="BuktiButton" Content="Cetak Ulang Kuitansi / Nota (PDF)" Click="OnBuktiClick"
                        HorizontalAlignment="Left" IsVisible="False" />
            </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>

        <Border Grid.Row="3" Classes="servicePanel">
            <Button Content="Kembali ke Menu" Click="OnBackClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.accentText">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
    </UserControl.Styles>
</UserControl>
