<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimrsGramedika.UI.LoginWindow"
        Title="Login — SIMRS Gramedika"
        Width="1080" Height="700" MinWidth="360" MinHeight="320" WindowStartupLocation="CenterScreen"
        WindowState="FullScreen"
        Icon="avares://SimrsGramedika.UI/Assets/app.ico"
        RequestedThemeVariant="Light"
        Background="#F8FAFC">

    <Grid ColumnDefinitions="57*,43*" RowDefinitions="Auto,*">
        <ScrollViewer Name="FormScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      VerticalContentAlignment="Stretch">
            <Border MaxWidth="348" Padding="24,12,24,48" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,17">
                        <Image Source="{StaticResource GramedikaMark}" Width="42" Height="42"
                               Stretch="Uniform" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="SIMRS Gramedika" FontSize="22" FontWeight="Bold"
                                       Foreground="#152B54" TextWrapping="Wrap" />
                            <TextBlock Text="Masuk dengan akun rumah sakit" FontSize="12"
                                       Foreground="#475569" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Server / Database" FontSize="12" Foreground="#64748B" Margin="0,0,0,2" />
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,7">
                        <ComboBox Name="ServerBox" HorizontalAlignment="Stretch" MinHeight="36"
                                  AutomationProperties.Name="Server atau database" SelectionChanged="OnServerChanged" />
                        <Button Grid.Column="1" Name="KoneksiButton" Content="⚙" Margin="6,0,0,0" Padding="10,4"
                                AutomationProperties.Name="Atur koneksi database"
                                ToolTip.Tip="Atur koneksi database (host, port, database)" Click="OnKoneksiClick" />
                    </Grid>

                    <TextBlock Text="User ID" FontSize="12" Foreground="#64748B" Margin="0,0,0,2" />
                    <TextBox Name="UserIdBox" AutomationProperties.Name="User ID" MinHeight="36" Margin="0,0,0,7" />

                    <TextBlock Text="Password" FontSize="12" Foreground="#64748B" Margin="0,0,0,2" />
                    <TextBox Name="PasswordBox" AutomationProperties.Name="Password" PasswordChar="*" MinHeight="36" />

                    <TextBlock Name="ErrorText" Foreground="#DC2626" FontSize="12" IsVisible="False"
                               TextWrapping="Wrap" Margin="0,8,0,0" />

                    <Button Name="LoginButton" Content="Masuk" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Margin="0,11,0,0" MinHeight="38" Padding="0,6"
                            Background="#1E3A8A" Foreground="White" CornerRadius="6"
                            FontWeight="Medium" Click="OnLoginClick" />

                    <TextBlock Name="ServerInfo" FontSize="11" Foreground="#475569"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Name="PhotoPanel" Grid.RowSpan="2" Background="#152B54" ClipToBounds="True">
            <Image Source="avares://SimrsGramedika.UI/Assets/login-gramedika.png" Stretch="UniformToFill"
                   AutomationProperties.Name="Foto gedung RS Gramedika 10" />
        </Border>
        <StackPanel Name="WindowActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="12,16,16,8" Spacing="8">
            <Button Classes="caption" Name="FullscreenButton" Click="OnFullscreenClick" />
            <Button Name="FullscreenCloseButton" Classes="caption close" Content="✕" AutomationProperties.Name="Tutup" Click="OnCloseClick" />
        </StackPanel>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="#E7EEF8" />
            <Setter Property="Foreground" Value="#152B54" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CFDEF3" />
            <Setter Property="Foreground" Value="#152B54" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FDCFD3" />
        </Style>
    </Window.Styles>
</Window>
