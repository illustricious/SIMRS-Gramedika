<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        xmlns:controls="using:SimrsGramedika.UI.Controls"
        x:Class="SimrsGramedika.UI.MainWindow"
        Title="SIMRS Gramedika"
        Icon="avares://SimrsGramedika.UI/Assets/app.ico"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="540"
        WindowState="FullScreen"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ThemeBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Row 0: application shortcuts and window controls. -->
        <Border Grid.Row="0" Name="TitleBar" Background="{DynamicResource TegasNavigationBrush}" MinHeight="42"
                BorderBrush="{DynamicResource ThemeAccentBrush}" BorderThickness="0,0,0,2"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="{StaticResource GramedikaMark}" Width="28" Height="28" Margin="14,0,8,0"
                           VerticalAlignment="Center" />
                    <Button Classes="shortcut" Content="Program" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Presensi Pegawai" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Informasi" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Anjungan &amp; Antrian" Click="OnTopShortcutClick" />
                    <Button Classes="shortcut" Content="Tentang Program" Click="OnTopShortcutClick" />
                    <Border Width="1" Background="#627B9F" Margin="6,9" />
                    <ToggleButton Name="ThemeToggle" Classes="shortcut" Content="Mode Gelap"
                                  Click="OnThemeToggleClick" HorizontalAlignment="Right" />
                </StackPanel>
                <controls:WindowButtons Grid.Column="2" />
            </Grid>
        </Border>

        <!-- Row 1: feature shortcuts (direct access, mirrors legacy second toolbar row) -->
        <Border Grid.Row="1" Background="{DynamicResource ThemePanelBrush}"
                BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel Name="FeatureShortcuts" Orientation="Horizontal" Margin="12,6" ItemSpacing="3">
                <Button Name="MenuShortcut" Classes="shortcut2" Tag="Menu Utama" AutomationProperties.Name="Menu Utama" Click="OnMenuShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M3,3 H9 V9 H3 Z M13,3 H19 V9 H13 Z M3,13 H9 V19 H3 Z M13,13 H19 V19 H13 Z" />
                        <TextBlock Text="Menu Utama" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Registrasi" AutomationProperties.Name="Registrasi" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M8,5 H5 V21 H19 V5 H16 M8,3 H16 V7 H8 Z M8,12 H16 M8,16 H13" />
                        <TextBlock Text="Registrasi" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="IGD/UGD" AutomationProperties.Name="IGD/UGD" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M3,7 H21 V20 H3 Z M8,7 V4 H16 V7 M12,10 V17 M8.5,13.5 H15.5" />
                        <TextBlock Text="IGD/UGD" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Laboratorium" AutomationProperties.Name="Laboratorium" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M9,4 H15 M10,4 V10 L5,18 Q4,20 7,20 H17 Q20,20 19,18 L14,10 V4 M8,15 H16" />
                        <TextBlock Text="Laboratorium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Radiologi" AutomationProperties.Name="Radiologi" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M3,4 H21 V17 H3 Z M8,21 H16 M12,17 V21 M6,11 H10 L12,8 L14,14 L16,11 H18" />
                        <TextBlock Text="Radiologi" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Farmasi" AutomationProperties.Name="Farmasi" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M4,9 L9,4 A4,4 0 0 1 15,4 L20,9 A4,4 0 0 1 20,15 L15,20 A4,4 0 0 1 9,20 L4,15 A4,4 0 0 1 4,9 Z M7,7 L17,17" />
                        <TextBlock Text="Farmasi" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Rawat Inap" AutomationProperties.Name="Rawat Inap" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M3,7 V20 M21,20 V15 Q21,12 18,12 H10 V17 M3,17 H21 M6,12 A2,2 0 1 0 6,8 A2,2 0 0 0 6,12 Z" />
                        <TextBlock Text="Rawat Inap" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Classes="shortcut2" Tag="Rawat Jalan" AutomationProperties.Name="Rawat Jalan" Click="OnFeatureShortcutClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M12,12 A3,3 0 1 0 12,6 A3,3 0 0 0 12,12 M5,20 V18 C5,15 8,14 12,14 C16,14 19,15 19,18 V20" />
                        <TextBlock Text="Rawat Jalan" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="20" Margin="4,0" VerticalAlignment="Center" Background="{DynamicResource ThemeBorderBrush}" />
                <Button Classes="shortcut2 logout" Tag="Keluar" AutomationProperties.Name="Keluar" Click="OnExitClick">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.6"
                              StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Stroke="{ReflectionBinding $parent[Button].Foreground}" Data="M10,4 H4 V20 H10 M8,12 H20 M16,8 L20,12 L16,16" />
                        <TextBlock Text="Keluar" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- Shared dashboard and feature area. -->
        <Grid Grid.Row="2" Name="ContentHost" Background="{DynamicResource ThemeBackgroundBrush}">

            <Grid Name="MenuPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="24,20">
                <StackPanel Spacing="3" Margin="0,0,0,16">
                    <TextBlock Text="Menu Utama" Classes="pageTitle" />
                    <TextBlock Text="Pilih kategori untuk membuka menu" Classes="pageSubtitle" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,2*,3*,Auto" ColumnSpacing="12" Margin="0,0,0,12">
                    <TextBlock Text="Kategori" Classes="pageSubtitle menuSectionLabel" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Name="MenuCategoryCombo" HorizontalAlignment="Stretch" Height="38"
                              MaxDropDownHeight="440" AutomationProperties.Name="Kategori menu" />
                    <TextBox Grid.Column="2" Name="MenuSearchBox" PlaceholderText="Cari menu di semua kategori"
                             Height="38" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Cari menu di semua kategori" />
                    <Border Grid.Column="3" Background="{DynamicResource ThemeIconBackgroundBrush}"
                            CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Name="MenuCountText" Classes="menuCount" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="2" Name="DashboardScroll" AllowAutoHide="False" VerticalScrollBarVisibility="Visible">
                    <UniformGrid Name="DashboardPanel" Columns="5" VerticalAlignment="Top" />
                </ScrollViewer>
                <TextBlock Grid.Row="2" Name="EmptyMenuText" Classes="pageSubtitle" VerticalAlignment="Top" Margin="0,24,0,0"
                           IsVisible="False" />
            </Grid>

            <!-- Feature page host — single-window navigation: clicking a feature
                 shortcut (e.g. "Registrasi") swaps content in here instead of
                 opening a new Window, per the user's feedback. -->
            <ContentControl Name="PageHost" IsVisible="False" />
        </Grid>

        <!-- Row 3: status bar, mirrors legacy "Status Admin / date / IP / credit" footer -->
        <Border Grid.Row="3" Background="{DynamicResource ThemePrimaryDarkBrush}">
            <Grid ColumnDefinitions="*,Auto" Margin="12,4">
                <TextBlock Grid.Column="0" Name="LoggedInUserText" Text="Login sebagai: (belum terhubung)" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ThemeOnPrimaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Name="ClockText" Text=""
                           Foreground="{DynamicResource ThemeOnPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0" />
            </Grid>
        </Border>

    </Grid>

    <Window.Styles>
        <!-- Button and ToggleButton don't share a common styled base in Avalonia's
             selector grammar, so the "shortcut" look is declared once per type. -->
        <Style Selector="Button.shortcut, ToggleButton.shortcut">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.shortcut:pointerover /template/ ContentPresenter, ToggleButton.shortcut:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#31588A" />
        </Style>
        <Style Selector="Button.shortcut2">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.shortcut2.logout">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>
        <Style Selector="Button.shortcut2.current">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.shortcut2:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
        </Style>
        <Style Selector="TextBlock.menuSectionLabel">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.menuCount">
            <Setter Property="Foreground" Value="{DynamicResource ThemeIconBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.menuTile">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="116" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{DynamicResource ThemePanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.menuTile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeIconBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemePrimaryBrush}" />
        </Style>
        <Style Selector="Button.menuTile:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemePrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeOnPrimaryBrush}" />
        </Style>
        <Style Selector="Button.menuTile:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>
</Window>
